{
  "name": "bot-community",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply botruns --local",
    "db:migrate:remote": "wrangler d1 migrations apply botruns --remote",
    "db:seed": "wrangler d1 execute botruns --local --file=./seed/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "astro": "^7.2.2",
    "wrangler": "^4.123.0"
  }
}
