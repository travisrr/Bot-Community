{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "botruns",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ai": {
    "binding": "AI",
  },
  "triggers": {
    // Minute: tagged X imports first (stamp + reply), harvest remaining use-case replies, then thread revisit, then prompt-strengthen drain.
    // Daily 10:00 UTC (5:00 AM Central): stronger copyable prompt on every published Run.
    "crons": ["* * * * *", "0 10 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "botruns",
      // Production D1 for really.bot. Your Worker needs its own database_id.
      "database_id": "e06e4529-1705-4c8f-bccb-9dd617cca566",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "botruns-evidence",
    },
  ],
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SITE_ORIGIN": "https://really.bot",
    "MAIL_FROM": "really.bot <beep@really.bot>",
  },
}
