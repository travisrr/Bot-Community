---
import Layout from "../layouts/Layout.astro";
import ContinueWithX from "../components/ContinueWithX.astro";
import { canonical, SITE_EMAIL, SITE_NAME } from "../lib/site";
import { createSession, createMagicLink, loginWithPassword, sessionCookie, homePathFor, loginFlash, toPublicUser } from "../lib/auth";
import { sendEmail, mailerConfigured } from "../lib/email";
import { xConfigured } from "../lib/x-oauth";
import { redirectTo, safeNextPath } from "../lib/http";
import { flashCookie } from "../lib/flash";
import { rateLimit, clientIp } from "../lib/rate-limit";
import { getEnv } from "../lib/env";

const origin = Astro.locals.origin;
const next = safeNextPath(Astro.url.searchParams.get("next"));
const xOn = xConfigured();
const mailOn = mailerConfigured();
let error = "";
let magicHint = "";

if (Astro.locals.user) {
  return Astro.redirect(next);
}

if (Astro.request.method === "POST") {
  const allowed = await rateLimit(`auth:${clientIp(Astro.request)}`, 15, 60 * 60 * 1000);
  if (!allowed) {
    error = "Slow down. Rate limit.";
  } else {
    const form = await Astro.request.formData();
    const intent = String(form.get("intent") || "password");
    if (intent === "password") {
      const identifier = String(form.get("identifier") || "");
      const password = String(form.get("password") || "");
      const user = await loginWithPassword(identifier, password);
      if (!user) {
        error = "Those credentials did not match.";
      } else {
        const token = await createSession(user.id, origin);
        const view = toPublicUser(user);
        return redirectTo(homePathFor(view, next), [
          sessionCookie(token, origin),
          flashCookie(loginFlash(view, "password"), origin),
        ]);
      }
    } else if (intent === "magic") {
      if (!mailOn) {
        error = "Magic link is not available. Use a password or X.";
      } else {
        const email = String(form.get("email") || "").trim().toLowerCase();
        if (!email.includes("@")) {
          error = "Magic link needs an email.";
        } else {
          const token = await createMagicLink(email);
          const verify = `${origin}/login/magic?token=${encodeURIComponent(token)}&next=${encodeURIComponent(next)}`;
          const mailed = await sendEmail({
            to: email,
            subject: "really.bot login link",
            text: `Log in: ${verify}\n\nExpires in 30 minutes. If you did not ask, ignore this.\nIf the link fails, write ${SITE_EMAIL}.`,
          });
          if (mailed.sent) {
            magicHint = "Check your email.";
          } else if (getEnv().SITE_ORIGIN.includes("localhost") || origin.includes("localhost") || origin.includes("127.0.0.1")) {
            magicHint = `Mailer is off. Local link: ${verify}`;
          } else {
            error = "Could not send email. Use a password or X.";
          }
        }
      }
    }
  }
}

if (Astro.request.method === "GET" && Astro.url.searchParams.get("x") === "1") {
  return Astro.redirect(`/api/auth/x?next=${encodeURIComponent(next)}`);
}
---

<Layout
  title={`Log in | ${SITE_NAME}`}
  description={mailOn ? "Log in to really.bot with X, a password, or a magic link." : "Log in to really.bot with X or a password."}
  canonical={canonical(origin, "/login")}
  noindex
>
  <div class="narrow">
    <h1>Log in</h1>
    <p class="muted">
      {
        xOn && mailOn
          ? "Continue with X. Password and magic link still work."
          : xOn
            ? "Continue with X. Password still works."
            : mailOn
              ? "Email or username plus a password. Magic link if you have email."
              : "Email or username plus a password."
      }
    </p>
    {error && <p class="error" role="alert">{error}</p>}
    {magicHint && <p class="ok">{magicHint}</p>}
    <div class="auth-stack">
      <ContinueWithX next={next} />
      {xOn && <p class="auth-or">or</p>}
      <form method="post">
        <input type="hidden" name="intent" value="password" />
        <label>
          <span>Email or username</span>
          <input name="identifier" autocomplete="username" required />
        </label>
        <label>
          <span>Password</span>
          <input name="password" type="password" autocomplete="current-password" required />
        </label>
        <button type="submit">Log in</button>
      </form>
      {
        mailOn && (
          <form method="post">
            <input type="hidden" name="intent" value="magic" />
            <label>
              <span>Magic link email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
            <button class="secondary" type="submit">Email me a link</button>
          </form>
        )
      }
      <p><a href="/register">Create an account</a></p>
      <p class="muted">
        <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a> · <a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
      </p>
    </div>
  </div>
</Layout>
