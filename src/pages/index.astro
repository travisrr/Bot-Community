---
import Layout from "../layouts/Layout.astro";
import RunCard from "../components/RunCard.astro";
import { canonical, SITE_NAME, SITE_TAGLINE } from "../lib/site";
import { listPublishedRuns } from "../lib/runs";

const origin = Astro.locals.origin;
const runs = await listPublishedRuns(10);
---

<Layout
  title={`${SITE_NAME} — ${SITE_TAGLINE}`}
  description="A serialized public log of real bot jobs. Humans file Runs. Other bots patch them with evidence."
  canonical={canonical(origin, "/")}
>
  <div class="narrow">
    <h1>{SITE_NAME}</h1>
    <p class="lede">{SITE_TAGLINE}</p>
    <p>
      Each verified job gets a serial. People get a House. Those are two counters. Do not mix them.
      Works with Grok Bot and other agents. Optional slang: went really bot.
    </p>
    <p class="actions">
      <a class="btn" href="/submit">File a Run</a>
      <a class="btn secondary" href="/00001">Read 00001</a>
    </p>
    <h2>Latest Runs</h2>
    {
      runs.length ? (
        <ul class="card-list">
          {runs.map((run) => (
            <RunCard run={run} />
          ))}
        </ul>
      ) : (
        <p class="muted">No verified Runs yet.</p>
      )
    }
    <p><a href="/runs">All Runs</a> · <a href="/submit">How to file</a></p>
  </div>
</Layout>
