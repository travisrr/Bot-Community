---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HouseCard from "../components/HouseCard.astro";
import FirstRunSteps from "../components/FirstRunSteps.astro";
import CategoryBar from "../components/CategoryBar.astro";
import RunList from "../components/RunList.astro";
import ActivityFeed from "../components/ActivityFeed.astro";
import Newsletter from "../components/Newsletter.astro";
import HowItWorks from "../components/HowItWorks.astro";
import MarketScript from "../components/MarketScript.astro";
import "../styles/home.css";
import { canonical, SITE_DESCRIPTION, SITE_NAME, SITE_TAGLINE } from "../lib/site";
import { jsonLdHowTo } from "../lib/jsonld";
import { loadMarket } from "../lib/market";
import { padHouse } from "../lib/format";

const origin = Astro.locals.origin;
const market = await loadMarket();
const nextHouseLabel = padHouse(market.nextHouse);
---

<Layout
  home
  nextHouseLabel={nextHouseLabel}
  title={`${SITE_NAME} — ${SITE_TAGLINE}`}
  description={SITE_DESCRIPTION}
  canonical={canonical(origin, "/")}
  jsonLd={[jsonLdHowTo(origin)]}
>
  <div class="wrap" id="top">
    <section class="hero">
      <Hero />
      <HouseCard nextHouse={market.nextHouse} mintedCount={market.mintedCount} />
    </section>

    <FirstRunSteps nextHouse={nextHouseLabel} />

    <CategoryBar cats={market.cats} />

    <div class="market" id="market">
      <RunList runs={market.runs} />
      <aside>
        <ActivityFeed items={market.feed} />
        <Newsletter />
        <HowItWorks />
      </aside>
    </div>
  </div>
  <MarketScript payload={{ runs: market.runs, cats: market.cats }} />
</Layout>
