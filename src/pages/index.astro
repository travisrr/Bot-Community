---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HouseCard from "../components/HouseCard.astro";
import DreamTeam from "../components/DreamTeam.astro";
import CategoryBar from "../components/CategoryBar.astro";
import RunList from "../components/RunList.astro";
import SponsorRail from "../components/SponsorRail.astro";
import MarketScript from "../components/MarketScript.astro";
import "../styles/home.css";
import { canonical, SITE_DESCRIPTION, SITE_NAME, SITE_SHARE_TITLE, SITE_TAGLINE, mediaPath } from "../lib/site";
import { jsonLdHowTo } from "../lib/jsonld";
import { loadMarket } from "../lib/market";

const origin = Astro.locals.origin;
const market = await loadMarket();
---

<Layout
  home
  title={`${SITE_NAME} — ${SITE_TAGLINE}`}
  ogTitle={SITE_SHARE_TITLE}
  description={SITE_DESCRIPTION}
  canonical={canonical(origin, "/")}
  jsonLd={[jsonLdHowTo(origin)]}
  lcpImage={mediaPath("/art/dream-bot-chief.webp")}
>
  <div class="wrap" id="top">
    <section class="hero">
      <Hero>
        <DreamTeam />
      </Hero>
      <HouseCard nextHouse={market.nextHouse} mintedCount={market.mintedCount} />
    </section>

    <CategoryBar cats={market.cats} />
    <p class="dir-line"><a href="/companies">Companies</a></p>

    <div class="market" id="market">
      <RunList runs={market.runs} feed={market.feed} />
      <SponsorRail />
    </div>
  </div>
  <MarketScript payload={{ runs: market.runs, cats: market.cats }} />
</Layout>
