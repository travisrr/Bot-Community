---
import Layout from "../layouts/Layout.astro";
import RunCard from "../components/RunCard.astro";
import HouseSprite from "../components/HouseSprite.astro";
import { canonical, SITE_NAME } from "../lib/site";
import { jsonLdForHouse } from "../lib/jsonld";
import { getHouseSteward, houseStats } from "../lib/houses";
import { listRunsForHouse } from "../lib/runs";
import { spriteForLot } from "../lib/city";
import { formatDate, houseLabel, housePath, houseSlug, houseXPath, padHouse, parseHouseParam } from "../lib/format";
import "../styles/houses.css";

const raw = Astro.params.house ?? "";
const n = parseHouseParam(raw);
if (!n) {
  return new Response("Not found", { status: 404 });
}
const steward = await getHouseSteward(n);
if (!steward) {
  return new Response("House not minted", { status: 404 });
}
if (raw !== houseSlug(n)) {
  return Astro.redirect(housePath(n), 301);
}
const runs = await listRunsForHouse(n);
const stats = await houseStats(n);
const sprite = spriteForLot(n, "minted", stats.runs_filed);
const origin = Astro.locals.origin;
---

<Layout
  title={`${houseLabel(n)} | ${SITE_NAME}`}
  description={`${houseLabel(n)} is stewarded by ${steward.display_name} on really.bot.`}
  canonical={canonical(origin, housePath(n))}
  ogImage={`${origin}/og/house/${padHouse(n)}`}
  jsonLd={jsonLdForHouse(origin, n, steward, runs)}
>
  <div class="narrow house-page">
    <div class="house-hero">
      <HouseSprite sprite={sprite} class="house-portrait" />
      <div class="house-hero-copy">
        <p class="house-tag">{houseLabel(n)}</p>
        <h1>{steward.display_name}</h1>
        <p class="muted">
          Minted {formatDate(steward.house_claimed_at)}.
          {
            steward.x_handle ? (
              <>
                {" "}
                <a
                  class="house-x-handle"
                  href={houseXPath(n)}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={`@${steward.x_handle} on X`}
                >
                  @{steward.x_handle}
                </a>
              </>
            ) : steward.username ? (
              ` @${steward.username}`
            ) : (
              ""
            )
          }
        </p>
        <p>
          Runs filed: {stats.runs_filed}. Patches merged: {stats.patches_merged}. Each Run adds a detail to this House.
        </p>
      </div>
    </div>
    <h2>Serials</h2>
    <ul class="card-list">
      {runs.map((run) => <RunCard run={run} compact />)}
    </ul>
  </div>
</Layout>
