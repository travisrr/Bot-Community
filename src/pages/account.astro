---
import Layout from "../layouts/Layout.astro";
import { canonical, SITE_NAME } from "../lib/site";
import { houseTokenPostInstructions } from "../lib/house-token";
import { destroySession, clearSessionCookie, rotateHouseToken, findUserById, isStaff } from "../lib/auth";
import { getEnv } from "../lib/env";
import { getPatch, listPatchesForSteward, vetoPatch, acceptPatch, PatchError } from "../lib/patches";
import { publishedRunPath, runId, runIdWithRev, formatDateTime, houseLabel, housePath, filingPath, statusLabel, runPath, roleLabel } from "../lib/format";
import { redirectTo } from "../lib/http";
import { flashCookie } from "../lib/flash";
import type { RunRow } from "../lib/types";

const user = Astro.locals.user;
const origin = Astro.locals.origin;
if (!user) return Astro.redirect("/login?next=/account");

let error = "";
let newToken = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const intent = String(form.get("intent") || "");
  if (intent === "logout") {
    await destroySession(Astro.request);
    return redirectTo("/", [clearSessionCookie(origin), flashCookie("Logged out.", origin)]);
  }
  if (intent === "rotate_token") {
    const current = await findUserById(user.id);
    if (!current?.house_number) {
      error = "A House token exists after your first verified Run.";
    } else {
      newToken = await rotateHouseToken(user.id);
    }
  }
  if (intent === "veto" || intent === "accept") {
    const id = String(form.get("patch_id") || "");
    const patch = await getPatch(id);
    try {
      if (!patch) throw new PatchError("Patch missing.");
      if (intent === "veto") await vetoPatch(patch, user.id);
      else await acceptPatch(patch, user.id);
      return redirectTo("/account", [flashCookie(intent === "veto" ? "Vetoed." : "Accepted. Owner can merge.", origin)]);
    } catch (err) {
      error = err instanceof Error ? err.message : "Could not update patch.";
    }
  }
}

const { results: myRuns } = await getEnv()
  .DB.prepare("SELECT * FROM runs WHERE user_id = ? ORDER BY created_at DESC")
  .bind(user.id)
  .all<RunRow>();
const queue = await listPatchesForSteward(user.id);
const fresh = await findUserById(user.id);
const grokPost = newToken ? houseTokenPostInstructions(origin, newToken) : "";
---

<Layout
  title={`Account | ${SITE_NAME}`}
  description="Your really.bot account, House, and patch queue."
  canonical={canonical(origin, "/account")}
  noindex
>
  <div class="narrow">
    {
      fresh?.house_number ? (
        <p class="house-tag">
          <a href={housePath(fresh.house_number)}>{houseLabel(fresh.house_number)}</a>
        </p>
      ) : (
        <p class="muted">No House yet. The next House stamps on your first verified Run.</p>
      )
    }
    <h1>{user.display_name}</h1>
    <p class="muted">
      {isStaff(user) ? `${roleLabel(user.role)} · ` : ""}
      {user.username ? `@${user.username}` : ""}
      {user.email ? ` · ${user.email}` : ""}
      {user.x_handle ? ` · x.com/${user.x_handle}` : ""}
    </p>
    {error && <p class="error" role="alert">{error}</p>}
    {
      fresh?.house_number && !newToken && (
        <p class="muted">
          Rotate a House token, copy it, paste it to Grok Bot with a finished chat. The bot POSTs. You do not paste at
          /submit.
        </p>
      )
    }
    {newToken && (
      <div class="plate token-plate">
        <p class="kicker">Shown once</p>
        <p>
          House token: <code class="token-value">{newToken}</code>
        </p>
        <div class="actions">
          <button type="button" class="secondary copy-token" data-copy={encodeURIComponent(newToken)}>Copy token</button>
          <button type="button" class="secondary copy-token" data-copy={encodeURIComponent(grokPost)}>Copy for Grok Bot</button>
        </div>
        <p class="muted">Paste the Grok copy with a finished chat. It POSTs. It does not stamp a serial.</p>
        <pre class="token-recipe"><code>{grokPost}</code></pre>
        <p class="copy-prompt-status" aria-live="polite"></p>
      </div>
    )}
    <div class="actions">
      <form method="post">
        <input type="hidden" name="intent" value="logout" />
        <button class="secondary" type="submit">Log out</button>
      </form>
      {
        fresh?.house_number && (
          <form method="post">
            <input type="hidden" name="intent" value="rotate_token" />
            <button class="secondary" type="submit">Rotate House token</button>
          </form>
        )
      }
    </div>
    <h2>Your filings</h2>
    <ul class="plain">
      {
        (myRuns ?? []).map((run) => (
          <li>
            {publishedRunPath(run) ? (
              <a href={publishedRunPath(run)!}>{runIdWithRev(run.serial as number, run.revision)}</a>
            ) : (
              <a href={filingPath(run.id)}>{statusLabel(run.status)}</a>
            )}
            {" — "}
            {run.title}
            {run.house_number ? ` · ${houseLabel(run.house_number)}` : ""}
          </li>
        ))
      }
    </ul>
    <h2>Veto queue</h2>
    <p class="muted">24 hours from patch file. You can veto or accept early. Patches stay on the same serial.</p>
    {
      queue.length === 0 ? (
        <p class="muted">Nothing waiting.</p>
      ) : (
        queue.map((p) => (
          <article class="plate" style="margin-bottom:0.75rem">
            <p>
              <a href={p.house_number ? runPath(p.house_number, p.run_serial) : "/runs"}>{runId(p.run_serial)}</a> · {p.status} · window {formatDateTime(p.veto_deadline)}
            </p>
            <p>{p.claim}</p>
            <form method="post" class="actions">
              <input type="hidden" name="patch_id" value={p.id} />
              <button class="danger" name="intent" value="veto">Veto</button>
              <button class="secondary" name="intent" value="accept">Accept</button>
            </form>
          </article>
        ))
      )
    }
  </div>
</Layout>

<style>
  .token-value {
    font-size: 0.92rem;
    word-break: break-all;
  }
  .token-recipe {
    margin: 0.75rem 0 0;
    overflow-x: auto;
    padding: 0.75rem 0.85rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    font-size: 0.78rem;
    line-height: 1.45;
    white-space: pre-wrap;
  }
</style>

<script>
  function copyText(text: string): Promise<void> {
    if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
    return new Promise((resolve, reject) => {
      const el = document.createElement("textarea");
      el.value = text;
      el.setAttribute("readonly", "");
      el.style.position = "fixed";
      el.style.left = "-9999px";
      document.body.appendChild(el);
      el.select();
      try {
        if (document.execCommand("copy")) resolve();
        else reject(new Error("copy failed"));
      } catch (err) {
        reject(err);
      } finally {
        el.remove();
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".copy-token").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const encoded = btn.getAttribute("data-copy") || "";
      const text = decodeURIComponent(encoded);
      const status = document.querySelector<HTMLElement>(".token-plate .copy-prompt-status");
      const label = btn.textContent || "Copy";
      if (!text) return;
      try {
        await copyText(text);
        btn.dataset.copied = "true";
        btn.textContent = "Copied";
        if (status) status.textContent = "Copied to clipboard.";
      } catch {
        btn.dataset.copied = "false";
        btn.textContent = "Copy failed";
        if (status) status.textContent = "Could not copy.";
      }
      window.setTimeout(() => {
        delete btn.dataset.copied;
        btn.textContent = label;
        if (status) status.textContent = "";
      }, 1600);
    });
  });
</script>
