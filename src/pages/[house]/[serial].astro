---
import Layout from "../../layouts/Layout.astro";
import RunStamp from "../../components/RunStamp.astro";
import PromptCallout from "../../components/PromptCallout.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import PatchPrompt from "../../components/PatchPrompt.astro";
import { canonical, SITE_NAME } from "../../lib/site";
import {
  changelogFor,
  getRunBySerial,
  getSteward,
  openPatchCount,
  parseEvidence,
} from "../../lib/runs";
import { faqsForRun, firstSentence, jsonLdForRun } from "../../lib/jsonld";
import { parseJsonArray, paragraphsHtml } from "../../lib/html";
import {
  formatDate,
  houseLabel,
  housePath,
  houseSlug,
  padSerial,
  parseHouseParam,
  parseSerialParam,
  runIdWithRev,
  runPath,
  wouldLabel,
} from "../../lib/format";
import { collectEvidence } from "../../lib/evidence";
import { submitPatch, PatchError } from "../../lib/patches";
import { parsePatchFields } from "../../lib/forms";
import { buildPatchPrompt } from "../../lib/patch-prompt";
import { redirectTo } from "../../lib/http";
import { flashCookie } from "../../lib/flash";
import { rateLimit, clientIp } from "../../lib/rate-limit";
import { isStaff } from "../../lib/auth";

const rawHouse = Astro.params.house ?? "";
const rawSerial = Astro.params.serial ?? "";
const house = parseHouseParam(rawHouse);
const serial = parseSerialParam(rawSerial);
if (!house || !serial) return new Response("Not found", { status: 404 });

const run = await getRunBySerial(serial);
if (!run) return new Response("Not found", { status: 404 });
if (!run.house_number) return new Response("Not found", { status: 404 });
if (run.house_number !== house) {
  return Astro.redirect(runPath(run.house_number, serial), 301);
}

const path = runPath(house, serial);
if (rawHouse !== houseSlug(house) || rawSerial !== padSerial(serial)) {
  return Astro.redirect(path, 301);
}

const user = Astro.locals.user;
const origin = Astro.locals.origin;
const isPublic = run.status === "published";
const canSee = isPublic || user?.id === run.user_id || isStaff(user);
if (!canSee) return new Response("Not found", { status: 404 });

let error = "";
if (Astro.request.method === "POST" && isPublic) {
  if (!user) return Astro.redirect(`/login?next=${path}`);
  const allowed = await rateLimit(`patch:${user.id}:${clientIp(Astro.request)}`, 12, 60 * 60 * 1000);
  if (!allowed) error = "Slow down. Rate limit.";
  else {
    const form = await Astro.request.formData();
    try {
      const fields = parsePatchFields(form);
      const evidence = await collectEvidence(form);
      await submitPatch({
        run,
        user,
        claim: fields.claim,
        evidence,
        proposed_title: fields.proposed_title,
        proposed_job_text: fields.proposed_job_text,
        proposed_prompt: fields.proposed_prompt,
        proposed_what_happened: fields.proposed_what_happened,
      });
      return redirectTo(path, [flashCookie("Patch queued. Steward has 24 hours to veto.", origin)]);
    } catch (err) {
      error = err instanceof PatchError || err instanceof Error ? err.message : "Could not file patch.";
    }
  }
}

const steward = await getSteward(run.user_id);
const changelog = await changelogFor(serial);
const patchesOpen = await openPatchCount(serial);
const faqs = faqsForRun(run);
const jsonLd = isPublic ? jsonLdForRun(run, origin, steward, faqs) : [];
const patchPrompt = isPublic ? buildPatchPrompt(run, origin, path, changelog) : "";
const evidence = parseEvidence(run.evidence_json);
const connectors = parseJsonArray(run.connectors);
const title = `${runIdWithRev(serial, run.revision)} — ${run.title} | ${SITE_NAME}`;
const description = firstSentence(run.what_happened || run.job_text);
---

<Layout
  title={title}
  description={description}
  canonical={canonical(origin, path)}
  jsonLd={jsonLd}
  noindex={!isPublic}
  ogType="article"
  publishedTime={run.published_at ?? undefined}
  modifiedTime={run.updated_at}
  alternates={
    isPublic
      ? [
          { type: "application/json", href: canonical(origin, `${path}.json`), title: "JSON" },
          { type: "text/markdown", href: canonical(origin, `${path}.md`), title: "Markdown" },
        ]
      : []
  }
>
  <article class="narrow">
    <RunStamp serial={serial} revision={run.revision} house={run.house_number} publishedAt={run.published_at} />
    <h1>{run.title}</h1>
    {run.prompt_text && <PromptCallout text={run.prompt_text} />}
    <p>
      {run.job_text.split(/\n/)[0]} {run.what_happened.split(/\n/)[0]}
    </p>
    <Disclaimer kind={run.sensitive_kind} />
    <p class="alts">
      <a href={`${path}.json`}>JSON</a>
      · <a href={`${path}.md`}>Markdown</a>
      {run.house_number ? (
        <>
          · <a href={housePath(run.house_number)}>{houseLabel(run.house_number)}</a>
        </>
      ) : null}
      {steward && <span> · Steward {steward.display_name}</span>}
      {!isPublic && <span> · {run.status}</span>}
    </p>

    <h2>Job</h2>
    <Fragment set:html={paragraphsHtml(run.job_text)} />

    <h2>Connectors</h2>
    <p>{connectors.length ? connectors.join(", ") : "None listed."}</p>

    <h2>What happened</h2>
    <Fragment set:html={paragraphsHtml(run.what_happened)} />

    {
      run.constraints && (
        <>
          <h2>Constraints</h2>
          <Fragment set:html={paragraphsHtml(run.constraints)} />
        </>
      )
    }

    <h2>Would run again</h2>
    <p>{wouldLabel(run.would_run_again)}</p>

    <h2>Evidence</h2>
    {
      evidence.length === 0 ? (
        <p class="muted">No files. See the note in what happened if the screenshots stay private.</p>
      ) : (
        evidence.map((item) => (
          <figure class="evidence">
            {item.kind === "image" && item.url && (
              <img src={item.url} alt={item.alt || "Evidence screenshot"} />
            )}
            {item.kind === "url" && item.href && (
              <p>
                <a href={item.href} rel="nofollow noopener">{item.href}</a>
                {item.note ? ` — ${item.note}` : ""}
              </p>
            )}
            {item.kind === "note" && <p>{item.note}</p>}
            {item.alt && item.kind === "image" && <figcaption class="muted">{item.alt}</figcaption>}
          </figure>
        ))
      )
    }

    <h2>Changelog</h2>
    <ul class="plain">
      {changelog.map((c) => (
        <li>
          r{c.revision}: {c.one_liner} {c.created_at ? `(${formatDate(c.created_at)})` : ""}
        </li>
      ))}
    </ul>
    {patchesOpen > 0 && <p class="muted">{patchesOpen} open patch{patchesOpen === 1 ? "" : "es"}.</p>}

    <FaqBlock items={faqs} />

    {
      isPublic && (
        <section>
          <h2>Patch this Run</h2>
          <p>
            Same job, better version. Copy the prompt, paste it into your AI, paste the reply, attach evidence.
            Steward veto window is 24 hours.
          </p>
          {error && <p class="error" role="alert">{error}</p>}
          {!user && (
            <p>
              <a href={`/login?next=${path}`}>Log in</a> to submit. You can copy the prompt first.
            </p>
          )}
          <PatchPrompt text={patchPrompt} />
          <form method="post" enctype="multipart/form-data">
            <label>
              <span>2. Paste the reply</span>
              <textarea
                name="markdown"
                required
                minlength="20"
                placeholder={"# What is better\n\nOne paragraph. Tie it to the evidence.\n"}
              ></textarea>
            </label>
            <p class="muted">A plain paragraph works if that is the whole claim.</p>
            <label>
              <span>3. Evidence files</span>
              <input type="file" name="evidence_file" accept="image/*,.pdf,.txt" multiple />
            </label>
            <label>
              <span>Alt text</span>
              <input name="evidence_alt" placeholder="What the screenshot shows" />
            </label>
            <details class="patch-extra">
              <summary>Or a URL / note if the screenshot stays private</summary>
              <label>
                <span>Evidence URL</span>
                <input name="evidence_url" type="url" placeholder="https://" />
              </label>
              <label>
                <span>Note for that URL</span>
                <input name="evidence_url_note" />
              </label>
              <label>
                <span>Evidence note</span>
                <textarea
                  name="evidence_note"
                  class="short"
                  placeholder="Describe what the screenshot showed. Redact PII."
                ></textarea>
              </label>
            </details>
            <button type="submit" disabled={!user}>Patch this Run</button>
          </form>
        </section>
      )
    }
  </article>
</Layout>
