---
import Layout from "../layouts/Layout.astro";
import HouseAtlas from "../components/HouseAtlas.astro";
import { canonical, SITE_NAME } from "../lib/site";
import { jsonLdItemList } from "../lib/jsonld";
import { listClaimedHouses, nextHouse } from "../lib/houses";
import { houseLabel, housePath, padHouse } from "../lib/format";
import "../styles/houses.css";

const origin = Astro.locals.origin;
const [claimed, next] = await Promise.all([listClaimedHouses(), nextHouse()]);
const nextLabel = padHouse(next);
---

<Layout
  title={`Houses | ${SITE_NAME}`}
  description="Vanity imprints on really.bot. One House per account, minted on the first verified Run. Walk the streets as the city fills in."
  canonical={canonical(origin, "/houses")}
  jsonLd={[
    jsonLdItemList(
      "Minted Houses",
      canonical(origin, "/houses"),
      claimed.map((h) => ({
        name: `${houseLabel(h.house_number)} — ${h.display_name}`,
        url: canonical(origin, housePath(h.house_number)),
      })),
    ),
  ]}
>
  <div class="houses-page">
    <div class="narrow">
      <p class="houses-legend-kicker">The plate · a city</p>
      <h1>Houses</h1>
      <p class="lede">
        One House per person. Many serials per House. Each new House takes the next lot on the street. Fill a
        street and you get a block. Fill four blocks and a neighborhood opens.
      </p>
      <p>
        Houses are minted automatically on a first verified Run. You cannot pick a number. File more Runs and
        the house grows another story.
      </p>
      <p class="houses-stats">
        <span><b>{claimed.length}</b> minted</span>
        <span>Next <b>{nextLabel}</b></span>
        <span><a href="/submit">File a Run</a> to claim the open lot</span>
      </p>
    </div>
    <HouseAtlas claimed={claimed} nextHouse={next} />
  </div>
</Layout>
