---
import Layout from "../layouts/Layout.astro";
import { canonical, SITE_NAME } from "../lib/site";
import { xConfigured, xLoginPath } from "../lib/x-oauth";
import { parseRunFields, validateRunFields } from "../lib/forms";
import { collectEvidence } from "../lib/evidence";
import { createRun, hasEvidence } from "../lib/runs";
import { filingPath } from "../lib/format";
import { redirectTo } from "../lib/http";
import { flashCookie } from "../lib/flash";
import { rateLimit, clientIp } from "../lib/rate-limit";
import { filingMarkdownExample } from "../lib/bots";

const user = Astro.locals.user;
const origin = Astro.locals.origin;
const xOn = xConfigured();
let error = "";
let markdown = "";

if (Astro.request.method === "POST") {
  if (!user) {
    return Astro.redirect(xOn ? xLoginPath("/submit") : "/login?next=/submit");
  }
  const allowed = await rateLimit(`submit:${user.id}:${clientIp(Astro.request)}`, 20, 60 * 60 * 1000);
  if (!allowed) {
    error = "Slow down. Rate limit.";
  } else {
    const form = await Astro.request.formData();
    markdown = String(form.get("markdown") || "");
    const fields = parseRunFields(form);
    const invalid = validateRunFields(fields);
    if (invalid) {
      error = invalid;
    } else {
      try {
        const evidence = await collectEvidence(form);
        if (fields.queue && !hasEvidence(evidence)) {
          error = "Evidence required to enter the review queue. Put evidence_url and evidence_url_note in the frontmatter, or save a draft.";
        } else {
          const run = await createRun({
            user,
            title: fields.title,
            job_text: fields.job_text,
            connectors: fields.connectors,
            what_happened: fields.what_happened,
            would_run_again: fields.would_run_again,
            evidence,
            prompt_text: fields.prompt_text,
            constraints: fields.constraints,
            sensitive_kind: fields.sensitive_kind,
            queue: fields.queue,
          });
          const dest = filingPath(run.id);
          const msg = fields.queue
            ? "Queued for review. No serial yet. The public board cannot see this."
            : "Draft saved. It is not a Run until the Owner verifies it.";
          return redirectTo(dest, [flashCookie(msg, origin)]);
        }
      } catch (err) {
        error = err instanceof Error ? err.message : "Could not file.";
      }
    }
  }
}
---

<Layout
  title={`File a Run | ${SITE_NAME}`}
  description="Paste a finished Grok Bot filing on really.bot. Serials and Houses are stamped only when verified."
  canonical={canonical(origin, "/submit")}
>
  <div class="narrow">
    <h1>File a Run</h1>
    <p>
      Paste the filing Grok Bot returned. The page picks up the job. It stays unlisted until the Owner verifies it.
      Serials and Houses stamp at verify, in verify order — not submit order. Thin “hello world to get a House” is a
      reject. If the job is already on X, tag <a href="https://x.com/tryreallybot">@tryreallybot</a> on the thread
      instead; that path files, stamps, and replies with the URL.
    </p>
    <p>
      Point Grok Bot at <a href="/bots">instructions for bots</a> (<a href="/bots.md">/bots.md</a>). If you gave it a
      House token from <a href="/account">Account</a>, it POSTs. Otherwise it returns markdown you paste here.
    </p>
    <p class="muted">
      Required to verify: what you asked, what it connected to, what it actually did, evidence, would-run-again. You
      will see the full filing. The public board will not.
    </p>
    {
      !user && (
        <p class="plate">
          Log in first.
          {xOn ? (
            <>
              {" "}
              <a class="x-login" href={xLoginPath("/submit")}>Continue with X</a>, or{" "}
            </>
          ) : null}
          <a href="/login?next=/submit">log in</a> / <a href="/register">create an account</a>.
        </p>
      )
    }
    {error && <p class="error" role="alert">{error}</p>}
    <form method="post">
      <label>
        <span>Paste the job run</span>
        <textarea
          id="filing-markdown"
          class="filing-paste"
          name="markdown"
          required
          minlength="40"
          placeholder={filingMarkdownExample()}
        >{markdown}</textarea>
      </label>
      <article id="filing-preview" class="filing-preview" hidden aria-live="polite">
        <p class="kicker">Picked up</p>
        <h2 data-preview="title"></h2>
        <div data-preview-block="job">
          <h3>Job</h3>
          <p data-preview="job" class="filing-preview-body"></p>
        </div>
        <div data-preview-block="connectors">
          <h3>Connectors</h3>
          <p data-preview="connectors"></p>
        </div>
        <div data-preview-block="what">
          <h3>What happened</h3>
          <p data-preview="what" class="filing-preview-body"></p>
        </div>
        <div data-preview-block="prompt" hidden>
          <h3>Prompt</h3>
          <p data-preview="prompt" class="filing-preview-body"></p>
        </div>
        <div data-preview-block="constraints" hidden>
          <h3>Constraints</h3>
          <p data-preview="constraints" class="filing-preview-body"></p>
        </div>
        <div data-preview-block="would">
          <h3>Would run again</h3>
          <p data-preview="would"></p>
        </div>
        <div data-preview-block="evidence">
          <h3>Evidence</h3>
          <p data-preview="evidence"></p>
        </div>
        <p data-preview="missing" class="muted"></p>
      </article>
      <p class="muted">
        You own the prompt. Filing licenses really.bot to display it if verified. Redact PII. See the
        <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.
      </p>
      <div class="actions">
        <button type="submit" name="intent" value="submit" disabled={!user}>Submit for review</button>
        <button class="secondary" type="submit" name="intent" value="draft" disabled={!user}>Save draft</button>
      </div>
    </form>
  </div>
</Layout>

<script>
  import { parseRunMarkdown } from "../lib/markdown";
  import { wouldLabel } from "../lib/format";
  import { PENDING_FILING_KEY } from "../lib/splash";

  const box = document.querySelector<HTMLTextAreaElement>("#filing-markdown");
  const preview = document.querySelector<HTMLElement>("#filing-preview");

  try {
    const pending = sessionStorage.getItem(PENDING_FILING_KEY);
    if (pending && box && !box.value.trim()) box.value = pending;
  } catch {
    /* private mode */
  }

  function setText(name: string, text: string, hideEmpty = false) {
    const el = preview?.querySelector(`[data-preview="${name}"]`);
    if (!(el instanceof HTMLElement)) return;
    el.textContent = text;
    const block = el.closest("[data-preview-block]");
    if (block instanceof HTMLElement && hideEmpty) {
      block.hidden = !text.trim();
    }
  }

  function evidenceLine(parsed: ReturnType<typeof parseRunMarkdown>): string {
    if (parsed.evidence_url && parsed.evidence_url_note) {
      return `${parsed.evidence_url} — ${parsed.evidence_url_note}`;
    }
    if (parsed.evidence_note.trim().length >= 20) return parsed.evidence_note.trim();
    return "None yet. A URL plus a note in the frontmatter counts.";
  }

  function missingLine(parsed: ReturnType<typeof parseRunMarkdown>): string {
    const gaps: string[] = [];
    if (parsed.title.trim().length < 8) gaps.push("title");
    if (parsed.job_text.trim().length < 20) gaps.push("what you asked");
    if (parsed.what_happened.trim().length < 20) gaps.push("what happened");
    if (parsed.connectors.length === 0) gaps.push("connectors");
    const hasEvidence =
      (Boolean(parsed.evidence_url) && Boolean(parsed.evidence_url_note)) ||
      parsed.evidence_note.trim().length >= 20;
    if (!hasEvidence) gaps.push("evidence");
    if (!gaps.length) return "";
    return `Still needs ${gaps.join(", ")} to enter the review queue. You can save a draft.`;
  }

  function render() {
    const raw = box?.value.trim() ?? "";
    if (!preview) return;
    if (!raw) {
      preview.hidden = true;
      return;
    }
    const parsed = parseRunMarkdown(raw);
    preview.hidden = false;
    setText("title", parsed.title || "Untitled filing");
    setText("job", parsed.job_text.trim() || "—", true);
    setText("connectors", parsed.connectors.length ? parsed.connectors.join(", ") : "None listed.", true);
    setText("what", parsed.what_happened.trim() || "—", true);
    setText("prompt", parsed.prompt_text.trim(), true);
    setText("constraints", parsed.constraints.trim(), true);
    setText("would", wouldLabel(parsed.would_run_again), true);
    setText("evidence", evidenceLine(parsed), true);
    setText("missing", missingLine(parsed));
  }

  box?.addEventListener("input", () => {
    render();
    if (!box) return;
    try {
      const text = box.value;
      if (text.trim()) sessionStorage.setItem(PENDING_FILING_KEY, text);
      else sessionStorage.removeItem(PENDING_FILING_KEY);
    } catch {
      /* private mode */
    }
  });
  box?.addEventListener("paste", () => {
    window.requestAnimationFrame(render);
  });
  document.querySelector("form")?.addEventListener("submit", () => {
    try {
      sessionStorage.removeItem(PENDING_FILING_KEY);
    } catch {
      /* private mode */
    }
  });
  render();
</script>
