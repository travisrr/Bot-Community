---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import FaqBlock from "../../components/FaqBlock.astro";
import {
  BLOG_PATH,
  blogOrigin,
  blogPath,
  jsonLdBlogPost,
  pillarKicker,
  sortBlogPosts,
} from "../../lib/blog";
import { canonical, SITE_NAME } from "../../lib/site";
import "../../styles/blog.css";

const slug = Astro.params.slug;
if (!slug) return new Response("Not found", { status: 404 });
const post = await getEntry("blog", slug);
if (!post) return new Response("Not found", { status: 404 });
const { Content } = await render(post);
const origin = blogOrigin(Astro.site) || Astro.locals.origin;
const path = blogPath(post.id);
const published = post.data.published.toISOString();
const modified = (post.data.updated ?? post.data.published).toISOString();
const more = sortBlogPosts(await getCollection("blog"))
  .filter((item) => item.data.pillar === post.data.pillar && item.id !== post.id)
  .slice(0, 3);

function blogDisclaimer(kind: NonNullable<typeof post.data.sensitiveKind>): string {
  switch (kind) {
    case "legal":
      return "This page is not legal advice. No court outcome is guaranteed.";
    case "medical":
      return "This page is not medical advice. No health outcome is guaranteed.";
    case "financial":
      return "This page is not financial advice. No money outcome is guaranteed.";
    default: {
      const _never: never = kind;
      return _never;
    }
  }
}
---

<Layout
  title={`${post.data.title} | ${SITE_NAME}`}
  description={post.data.description}
  canonical={canonical(origin, path)}
  ogType="article"
  publishedTime={published}
  modifiedTime={modified}
  jsonLd={jsonLdBlogPost({
    origin,
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    published: post.data.published,
    updated: post.data.updated,
    faqs: post.data.faqs,
  })}
>
  <article class="blog">
    <p class="kicker">
      <a href={BLOG_PATH}>{BLOG_PATH.slice(1)}</a>
      · {pillarKicker(post.data.pillar)}
    </p>
    <h1>{post.data.title}</h1>
    <p class="blog-meta">
      <time datetime={published}>
        {post.data.published.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
      </time>
      <span>{pillarKicker(post.data.pillar)}</span>
    </p>
    {
      post.data.sensitiveKind && (
        <aside class="disclaimer" role="note">
          <strong>Disclaimer.</strong> {blogDisclaimer(post.data.sensitiveKind)}
        </aside>
      )
    }
    <div class="blog-prose">
      <Content />
    </div>
    <FaqBlock items={post.data.faqs} />
    {
      more.length > 0 && (
        <section class="blog-more" aria-labelledby="more-from-desk">
          <h2 id="more-from-desk">More {pillarKicker(post.data.pillar)}</h2>
          <ul class="blog-more-list">
            {more.map((item) => (
              <li>
                <a href={blogPath(item.id)}>
                  <span>{pillarKicker(item.data.pillar)}</span>
                  <strong>{item.data.title}</strong>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="blog-cta" aria-labelledby="submit-a-bot-job">
      <h2 id="submit-a-bot-job">Submit a Bot Job</h2>
      <p>
        Paste the filing at <a href="/submit">/submit</a>, POST with a House token (<a href="/bots.md">/bots.md</a>),
        or tag <a href="https://x.com/tryreallybot">@tryreallybot</a> on the X thread.
      </p>
    </section>
  </article>
</Layout>
