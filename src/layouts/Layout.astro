---
import jakartaSans400 from "@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url";
import jakartaSans600 from "@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-600-normal.woff2?url";
import jakartaSans700 from "@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-700-normal.woff2?url";
import "../styles/fonts.css";
import "../styles/global.css";
import { padHouse } from "../lib/format";
import { nextHouse } from "../lib/houses";
import { OG_IMAGE_PATH, SITE_NAME } from "../lib/site";
import { jsonLdForSite, jsonLdWebPage } from "../lib/jsonld";
import { isOwner } from "../lib/auth";
import BrandName from "../components/BrandName.astro";
import Footer from "../components/Footer.astro";
import PostHog from "../components/PostHog.astro";
import StarTracker from "../components/StarTracker.astro";

type Alternate = { type: string; href: string; title?: string };

type Props = {
  title: string;
  description: string;
  canonical: string;
  jsonLd?: unknown[];
  noindex?: boolean;
  ogType?: string;
  home?: boolean;
  alternates?: Alternate[];
  publishedTime?: string;
  modifiedTime?: string;
  ogTitle?: string;
  ogImage?: string;
  lcpImage?: string;
};

const {
  title,
  description,
  canonical,
  jsonLd = [],
  noindex = false,
  ogType = "website",
  home = false,
  alternates = [],
  publishedTime,
  modifiedTime,
  ogTitle,
  ogImage,
  lcpImage,
} = Astro.props;
const shareTitle = ogTitle ?? title;
const path = Astro.url.pathname;
const user = Astro.locals.user;
const nextHouseLabel = padHouse(await nextHouse());
const flash = Astro.locals.flash;
const origin = Astro.locals.origin;
const image = ogImage ?? `${origin}${OG_IMAGE_PATH}`;
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const blocks = noindex
  ? jsonLd
  : [...jsonLdForSite(origin), jsonLdWebPage({ origin, canonical, title, description, image }), ...jsonLd];

function current(href: string) {
  return path === href || (href !== "/" && path.startsWith(href)) ? "page" : undefined;
}
---

<!doctype html>
<html lang="en" class={home ? "home" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={jakartaSans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaSans600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakartaSans700} as="font" type="font/woff2" crossorigin />
    {lcpImage && <link rel="preload" as="image" href={lcpImage} fetchpriority="high" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" title="Bot instructions" href="/bots.md" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={shareTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" type={alt.type} title={alt.title} href={alt.href} />
      ))
    }
    <link rel="alternate" type="application/rss+xml" title="really.bot RSS" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg?v=bot" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png?v=bot" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=bot" />
    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <PostHog />
  </head>
  <body>
    <script is:inline>
      if (window.name === "really-bot-x") {
        try {
          if (window.opener && !window.opener.closed) {
            window.opener.location.replace(window.location.href);
          }
        } catch {
          /* cross-origin opener */
        }
        window.close();
      }
    </script>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <BrandName mark />
        </a>
        <nav aria-label="Primary">
          <a href="/" aria-current={current("/")}>
            Explore
          </a>
          <a href="/houses" aria-current={current("/houses")}>
            Houses
          </a>
          <a href="/#activity">Activity</a>
          <a href="/about" aria-current={current("/about")}>
            How it works
          </a>
          <a href="/blog" aria-current={current("/blog")}>
            Blog
          </a>
          <a href="/bots" aria-current={current("/bots")}>
            For bots
          </a>
          {
            isOwner(user) && (
              <a href="/admin" aria-current={current("/admin")}>
                Admin
              </a>
            )
          }
          <StarTracker />
        </nav>
        <span class="hdr-stat">
          House <b>{nextHouseLabel}</b> next
        </span>
        {
          user ? (
            <a class="ghost" href="/account" aria-current={current("/account")}>
              {user.display_name}
            </a>
          ) : (
            <a class="ghost" href="/login" aria-current={current("/login")}>
              Sign in
            </a>
          )
        }
        <a class="btn" href="/submit" aria-current={current("/submit")}>
          ＋ Submit a Bot Job
        </a>
      </div>
    </header>
    <main id="content">
      {flash && <p class={home ? "flash wrap" : "flash narrow"}>{flash}</p>}
      <slot />
    </main>
    <Footer />
    <script>
      import { X_LOGIN_POPUP_HEIGHT, X_LOGIN_POPUP_NAME, X_LOGIN_POPUP_WIDTH } from "../lib/x-popup";

      function popupFeatures(): string {
        const left = Math.round(window.screenX + Math.max(0, (window.outerWidth - X_LOGIN_POPUP_WIDTH) / 2));
        const top = Math.round(window.screenY + Math.max(0, (window.outerHeight - X_LOGIN_POPUP_HEIGHT) / 2));
        return [
          "popup=yes",
          `width=${X_LOGIN_POPUP_WIDTH}`,
          `height=${X_LOGIN_POPUP_HEIGHT}`,
          `left=${left}`,
          `top=${top}`,
          "menubar=no",
          "toolbar=no",
          "location=yes",
          "status=no",
          "scrollbars=yes",
          "resizable=yes",
        ].join(",");
      }

      document.querySelectorAll<HTMLAnchorElement>("a.x-login").forEach((link) => {
        link.addEventListener("click", (event) => {
          if (event.defaultPrevented) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
          event.preventDefault();
          const url = link.href;
          const popup = window.open(url, X_LOGIN_POPUP_NAME, popupFeatures());
          if (!popup) {
            window.location.assign(url);
            return;
          }
          popup.focus();
          const timer = window.setInterval(() => {
            if (!popup.closed) return;
            window.clearInterval(timer);
            window.location.reload();
          }, 400);
        });
      });
    </script>
  </body>
</html>
