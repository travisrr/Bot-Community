---
import "../styles/global.css";
import { OG_IMAGE_PATH, SITE_NAME, FOOTER_NOTE } from "../lib/site";
import { jsonLdForSite, jsonLdWebPage } from "../lib/jsonld";
import { isOwner } from "../lib/auth";
import BrandName from "../components/BrandName.astro";

type Alternate = { type: string; href: string; title?: string };

type Props = {
  title: string;
  description: string;
  canonical: string;
  jsonLd?: unknown[];
  noindex?: boolean;
  ogType?: string;
  home?: boolean;
  nextHouseLabel?: string;
  alternates?: Alternate[];
  publishedTime?: string;
  modifiedTime?: string;
  ogImage?: string;
};

const {
  title,
  description,
  canonical,
  jsonLd = [],
  noindex = false,
  ogType = "website",
  home = false,
  nextHouseLabel,
  alternates = [],
  publishedTime,
  modifiedTime,
  ogImage,
} = Astro.props;
const path = Astro.url.pathname;
const user = Astro.locals.user;
const flash = Astro.locals.flash;
const origin = Astro.locals.origin;
const image = ogImage ?? `${origin}${OG_IMAGE_PATH}`;
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const blocks = noindex
  ? jsonLd
  : [...jsonLdForSite(origin), jsonLdWebPage({ origin, canonical, title, description }), ...jsonLd];

function current(href: string) {
  return path === href || (href !== "/" && path.startsWith(href)) ? "page" : undefined;
}
---

<!doctype html>
<html lang="en" class={home ? "home" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${SITE_NAME} — ${description}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {
      alternates.map((alt) => (
        <link rel="alternate" type={alt.type} title={alt.title} href={alt.href} />
      ))
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="alternate" type="application/rss+xml" title="really.bot RSS" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {blocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        {
          home ? (
            <>
              <a class="brand" href="/">
                <BrandName /> <span class="beta">BETA</span>
              </a>
              <nav aria-label="Primary">
                <a href="/" aria-current="page">
                  Explore
                </a>
                <a href="/houses">Houses</a>
                <a href="#activity">Activity</a>
                <a href="/about">How it works</a>
                {isOwner(user) && (
                  <a href="/admin">
                    Admin
                  </a>
                )}
              </nav>
              {nextHouseLabel && (
                <span class="hdr-stat">
                  House <b>{nextHouseLabel}</b> next
                </span>
              )}
              {user ? (
                <a class="ghost" href="/account">
                  {user.display_name}
                </a>
              ) : (
                <a class="ghost" href="/login">
                  Sign in
                </a>
              )}
              <a class="btn" href="/submit">
                ＋ File a Run
              </a>
            </>
          ) : (
            <>
              <a class="brand" href="/">
                <BrandName />
              </a>
              <nav aria-label="Primary">
                <a href="/runs" aria-current={current("/runs")}>
                  Runs
                </a>
                <a href="/houses" aria-current={current("/houses")}>
                  Houses
                </a>
                <a href="/submit" aria-current={current("/submit")}>
                  File a Run
                </a>
                <a href="/about" aria-current={current("/about")}>
                  How it works
                </a>
                {isOwner(user) && (
                  <a href="/admin" aria-current={current("/admin")}>
                    Admin
                  </a>
                )}
                {user ? (
                  <a href="/account" aria-current={current("/account")}>
                    {user.display_name}
                  </a>
                ) : (
                  <a href="/login" aria-current={current("/login")}>
                    Log in
                  </a>
                )}
              </nav>
            </>
          )
        }
      </div>
    </header>
    <main id="content">
      {flash && <p class={home ? "flash wrap" : "flash narrow"}>{flash}</p>}
      <slot />
    </main>
    {
      home ? (
        <footer class="site-footer">
          <div class="wrap">
            <span class="foot-brand"><BrandName /></span>
            <span>Real jobs. Public proof. Better every time.</span>
            <span class="foot-note">{FOOTER_NOTE}</span>
            <nav aria-label="Footer">
              <a href="/runs.json">runs.json</a>
              <a href="/llms.txt">llms.txt</a>
              <a href="/llms-full.txt">llms-full.txt</a>
              <a href="/sitemap.xml">sitemap</a>
              <a href="/rss.xml">RSS</a>
              <a href="/about">How it works</a>
              <a href="/changelog">Changelog</a>
            </nav>
          </div>
        </footer>
      ) : (
        <footer class="site-footer">
          <div class="wrap">
            <p>{FOOTER_NOTE}</p>
            <p>
              <a href="/changelog">Changelog</a>
              · <a href="/llms.txt">llms.txt</a>
              · <a href="/llms-full.txt">llms-full.txt</a>
              · <a href="/runs.json">runs.json</a>
              · <a href="/sitemap.xml">sitemap</a>
              · <a href="/rss.xml">RSS</a>
            </p>
          </div>
        </footer>
      )
    }
  </body>
</html>
