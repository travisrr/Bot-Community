---
import { formatDate, houseLabel, publishedRunPath, runId } from "../lib/format";
import { parseConnectors } from "../lib/tools";
import type { RunRow } from "../lib/types";

type Props = { run: RunRow; compact?: boolean };
const { run, compact = false } = Astro.props;
const serial = run.serial as number;
const path = publishedRunPath(run) ?? `/${runId(serial)}`;
const connectors = parseConnectors(run.connectors);
---

<li class:list={["run-card", compact && "run-card--compact"]}>
  <a class="serial-link" href={path}>{runId(serial)}</a>
  <h2><a href={path}>{run.title}</a></h2>
  <p class="muted">
    {formatDate(run.published_at)}
    {!compact && run.house_number ? ` · ${houseLabel(run.house_number)}` : ""}
    {connectors.length ? ` · ${connectors.join(", ")}` : ""}
  </p>
</li>
