---
import ContinueWithX from "./ContinueWithX.astro";
import BrandName from "./BrandName.astro";
import { firstRunExtractPrompt, filingMarkdownExample } from "../lib/bots";
import { GROK_CHAT_URL, SITE_NAME } from "../lib/site";
import { xConfigured } from "../lib/x-oauth";

const origin = Astro.locals.origin;
const xOn = xConfigured();
const prompt = firstRunExtractPrompt(origin);
const next = "/submit";
const loginAction = `/login?next=${encodeURIComponent(next)}`;
---

<section
  class="guest-splash"
  id="guest-splash"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guest-splash-title"
>
  <div class="guest-splash-scrim"></div>
  <div class="guest-splash-inner">
    <button type="button" class="guest-splash-close" aria-label="Close">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="M2 2l10 10M12 2L2 12"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"></path>
      </svg>
    </button>
    <header class="guest-splash-login">
      <div class="guest-splash-brand">
        <p class="brand"><BrandName mark /></p>
        <p class="kicker">Tasks and prompts from experts</p>
      </div>
      <div class="guest-splash-auth">
        <ContinueWithX next={next} />
        {xOn && <p class="guest-splash-or">or</p>}
        <form class="guest-splash-pw" method="post" action={loginAction}>
          <input type="hidden" name="intent" value="password" />
          <label>
            <span class="guest-splash-sr">Email or username</span>
            <input name="identifier" autocomplete="username" required placeholder="Email or username" />
          </label>
          <label>
            <span class="guest-splash-sr">Password</span>
            <input name="password" type="password" autocomplete="current-password" required placeholder="Password" />
          </label>
          <button type="submit">Log in</button>
        </form>
        <p class="guest-splash-auth-links">
          <a href={`/register?next=${encodeURIComponent(next)}`}>Create an account</a>
        </p>
      </div>
    </header>

    <div class="guest-splash-lede">
      <h1 id="guest-splash-title">Assemble your dream bot team.</h1>
      <p>
        Copy a task someone already proved, or file one you finished. The walkthrough below records your first Job
        Run — evidence of a real task, not a prompt pack.
      </p>
    </div>

    <div class="guest-splash-cols">
      <div class="guest-splash-col">
        <article class="guest-splash-step" data-prompt={encodeURIComponent(prompt)}>
          <h2>
            <span class="guest-splash-n" aria-hidden="true">1</span>
            Copy these instructions
          </h2>
          <pre class="guest-splash-prompt" tabindex="0">{prompt}</pre>
          <button type="button" class="guest-splash-copy" aria-label="Copy instructions">Copy instructions</button>
          <p class="guest-splash-copy-status" aria-live="polite"></p>
        </article>
        <article class="guest-splash-step">
          <h2>
            <span class="guest-splash-n" aria-hidden="true">2</span>
            Paste them into your Grok Bot chat window to extract a report on what task Grok did for you.
          </h2>
          <p>
            Open the chat where the job already happened. Paste the instructions. Grok returns a filing — not a plan.
          </p>
          <a class="btn secondary" href={GROK_CHAT_URL} target="_blank" rel="noopener noreferrer">
            Open Grok Bot
          </a>
        </article>
      </div>

      <article class="guest-splash-col guest-splash-file">
        <h2>
          <span class="guest-splash-n" aria-hidden="true">3</span>
          Paste the result your Grok Bot gives you below to add your first Job Run
        </h2>
        <form class="guest-splash-file-form" method="post" action="/submit">
          <input type="hidden" name="intent" value="submit" />
          <label>
            <span class="guest-splash-sr">Grok Bot filing</span>
            <textarea
              class="filing-paste"
              name="markdown"
              required
              minlength="40"
              placeholder={filingMarkdownExample()}></textarea>
          </label>
          <p class="guest-splash-file-status" aria-live="polite"></p>
          <div class="guest-splash-file-actions">
            <button type="submit">Submit a Bot Job</button>
            <p class="muted">
              Log in above first. {SITE_NAME} keeps the paste, then takes you to submit it.
            </p>
          </div>
        </form>
      </article>
    </div>
  </div>
</section>

<script>
  import { PENDING_FILING_KEY, SPLASH_DISMISS_KEY, SPLASH_DISMISSED } from "../lib/splash";

  function copyText(text: string): Promise<void> {
    if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
    return new Promise((resolve, reject) => {
      const el = document.createElement("textarea");
      el.value = text;
      el.setAttribute("readonly", "");
      el.style.position = "fixed";
      el.style.left = "-9999px";
      document.body.appendChild(el);
      el.select();
      try {
        if (document.execCommand("copy")) resolve();
        else reject(new Error("copy failed"));
      } catch (err) {
        reject(err);
      } finally {
        el.remove();
      }
    });
  }

  const root = document.getElementById("guest-splash");
  if (root) {
    const box = root.querySelector<HTMLTextAreaElement>("textarea[name='markdown']");
    const fileStatus = root.querySelector<HTMLElement>(".guest-splash-file-status");
    const loginBar = root.querySelector<HTMLElement>(".guest-splash-login");

    function savePaste() {
      if (!box) return;
      try {
        const text = box.value;
        if (text.trim()) sessionStorage.setItem(PENDING_FILING_KEY, text);
        else sessionStorage.removeItem(PENDING_FILING_KEY);
      } catch {
        /* private mode */
      }
    }

    function restorePaste() {
      if (!box || box.value.trim()) return;
      try {
        const pending = sessionStorage.getItem(PENDING_FILING_KEY);
        if (pending) box.value = pending;
      } catch {
        /* private mode */
      }
    }

    function dismissSplash() {
      try {
        sessionStorage.setItem(SPLASH_DISMISS_KEY, SPLASH_DISMISSED);
      } catch {
        /* private mode */
      }
      document.documentElement.dataset.splash = "off";
      document.removeEventListener("keydown", onEscape);
    }

    function onEscape(event: KeyboardEvent) {
      if (event.key === "Escape") dismissSplash();
    }

    restorePaste();
    box?.addEventListener("input", savePaste);

    const promptEl = root.querySelector<HTMLElement>(".guest-splash-prompt");
    promptEl?.addEventListener("click", () => {
      const sel = window.getSelection();
      if (!sel || !promptEl) return;
      const range = document.createRange();
      range.selectNodeContents(promptEl);
      sel.removeAllRanges();
      sel.addRange(range);
    });

    root.querySelector(".guest-splash-pw")?.addEventListener("submit", savePaste);
    root.querySelector(".x-login")?.addEventListener("click", savePaste);

    root.querySelector<HTMLButtonElement>(".guest-splash-copy")?.addEventListener("click", async (event) => {
      const btn = event.currentTarget;
      if (!(btn instanceof HTMLButtonElement)) return;
      const step = btn.closest("[data-prompt]");
      const text = decodeURIComponent(step?.getAttribute("data-prompt") || "");
      const status = step?.querySelector<HTMLElement>(".guest-splash-copy-status") ?? null;
      if (!text) return;
      try {
        await copyText(text);
        btn.dataset.copied = "true";
        btn.textContent = "Copied";
        if (status) status.textContent = "Copied. Paste it into Grok Bot.";
      } catch {
        btn.dataset.copied = "false";
        btn.textContent = "Copy failed";
        if (status) status.textContent = "Select the instructions and copy them.";
      }
      window.setTimeout(() => {
        delete btn.dataset.copied;
        btn.textContent = "Copy instructions";
        if (status) status.textContent = "";
      }, 1800);
    });

    root.querySelector(".guest-splash-file-form")?.addEventListener("submit", (event) => {
      savePaste();
      const text = box?.value.trim() ?? "";
      if (text.length < 40) {
        event.preventDefault();
        if (fileStatus) fileStatus.textContent = "Paste the filing Grok Bot returned first.";
        box?.focus();
        return;
      }
      event.preventDefault();
      if (fileStatus) {
        fileStatus.textContent = "Log in above to file this. Your paste is saved.";
      }
      loginBar?.classList.add("guest-splash-login-need");
      loginBar?.scrollIntoView({ block: "nearest", behavior: "smooth" });
      const identifier = root.querySelector<HTMLInputElement>("input[name='identifier']");
      const xBtn = root.querySelector<HTMLAnchorElement>(".x-login");
      (xBtn || identifier)?.focus();
    });

    root.querySelector(".guest-splash-close")?.addEventListener("click", dismissSplash);
    root.querySelector(".guest-splash-scrim")?.addEventListener("click", dismissSplash);
    document.addEventListener("keydown", onEscape);
  }
</script>
