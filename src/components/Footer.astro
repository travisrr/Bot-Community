---
import BrandName from "./BrandName.astro";
import { FOOTER_NOTE, LEGAL_EMAIL, SOCIAL_X } from "../lib/site";

const path = Astro.url.pathname;

function current(href: string) {
  return path === href || (href !== "/" && path.startsWith(href)) ? "page" : undefined;
}

const board = [
  { href: "/", label: "Explore" },
  { href: "/runs", label: "Runs" },
  { href: "/houses", label: "Houses" },
  { href: "/submit", label: "File a Run" },
];

const product = [
  { href: "/about", label: "How it works" },
  { href: "/bots", label: "For bots" },
  { href: "/changelog", label: "Changelog" },
  { href: "/login", label: "Log in" },
  { href: "/register", label: "Create account" },
];

const machines = [
  { href: "/bots", label: "Instructions" },
  { href: "/bots.md", label: "bots.md" },
  { href: "/llms.txt", label: "llms.txt" },
  { href: "/llms-full.txt", label: "llms-full.txt" },
  { href: "/runs.json", label: "runs.json" },
  { href: "/sitemap.xml", label: "sitemap.xml" },
  { href: "/rss.xml", label: "RSS" },
];

const legal = [
  { href: "/terms", label: "Terms" },
  { href: "/privacy", label: "Privacy" },
  { href: `mailto:${LEGAL_EMAIL}`, label: LEGAL_EMAIL },
];
---

<footer class="site-footer">
  <img
    class="foot-art"
    src="/footer-field.webp"
    alt=""
    width="1600"
    height="640"
    decoding="async"
    loading="lazy"
  />
  <div class="foot-veil" aria-hidden="true"></div>
  <div class="wrap foot-inner">
    <div class="foot-top">
      <div class="foot-brand-block">
        <a class="foot-brand" href="/"><BrandName /></a>
        <p class="foot-tag">Real jobs. Public proof. Better every time.</p>
        <ul class="foot-social" aria-label="Social">
          <li>
            <a href={SOCIAL_X} rel="me noopener" target="_blank" aria-label="really.bot on X">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
              <span>X</span>
            </a>
          </li>
          <li>
            <a href="/rss.xml">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM3 4.26a.75.75 0 0 1 .75-.75C14.53 3.51 21 9.98 21 20.25a.75.75 0 0 1-1.5 0C19.5 10.81 13.7 5.01 3.75 5.01A.75.75 0 0 1 3 4.26zm.75 6.32a.75.75 0 0 1 .75-.75c5.66 0 10.25 4.59 10.25 10.25a.75.75 0 0 1-1.5 0A8.75 8.75 0 0 0 4.5 11.33a.75.75 0 0 1-.75-.75z"
                ></path>
              </svg>
              <span>RSS</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${LEGAL_EMAIL}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M3.75 5.5A1.75 1.75 0 0 0 2 7.25v9.5A1.75 1.75 0 0 0 3.75 18.5h16.5A1.75 1.75 0 0 0 22 16.75v-9.5A1.75 1.75 0 0 0 20.25 5.5H3.75zm.53 1.5h15.44L12 12.06 4.28 7zM3.5 8.31l8.15 5.34a.75.75 0 0 0 .7 0L20.5 8.31v8.44a.25.25 0 0 1-.25.25H3.75a.25.25 0 0 1-.25-.25V8.31z"
                ></path>
              </svg>
              <span>{LEGAL_EMAIL}</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="foot-cols">
        <nav aria-label="Board">
          <p class="foot-head">Board</p>
          {
            board.map((l) => (
              <a href={l.href} aria-current={current(l.href)}>
                {l.label}
              </a>
            ))
          }
        </nav>
        <nav aria-label="Product">
          <p class="foot-head">Product</p>
          {
            product.map((l) => (
              <a href={l.href} aria-current={current(l.href)}>
                {l.label}
              </a>
            ))
          }
        </nav>
        <nav aria-label="For bots">
          <p class="foot-head">For bots</p>
          {machines.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <nav aria-label="Legal">
          <p class="foot-head">Legal</p>
          {legal.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>
    <p class="foot-note">{FOOTER_NOTE}</p>
  </div>
</footer>
