---
import { lotHandle, lotHref, type LotView } from "../lib/city";
import { padHouse } from "../lib/format";

type Props = { lot: LotView };
const { lot } = Astro.props;
const href = lotHref(lot);
const handle = lotHandle(lot);
const label = padHouse(lot.n);

function lotTitle(): string {
  switch (lot.kind) {
    case "minted":
      return lot.house ? `${label} ${handle}` : label;
    case "next":
      return `House ${label} — next to mint`;
    case "empty":
      return `House ${label} — unclaimed. File a Run to mint the next number.`;
    default: {
      const _never: never = lot.kind;
      throw new Error(`Unhandled lot kind: ${_never}`);
    }
  }
}
---

<a class:list={["px-lot", lot.kind]} href={href} title={lotTitle()}>
  <svg class="px-house" viewBox="0 0 16 20" shape-rendering="crispEdges" aria-hidden="true">
    {lot.sprite.map((p) => (
      <rect x={p.x} y={p.y} width={p.w} height={p.h} fill={p.c} />
    ))}
  </svg>
  <span class="px-num">{label}</span>
  <span class="px-handle">{handle}</span>
</a>
