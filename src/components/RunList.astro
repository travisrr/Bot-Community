---
import ActivityFeed from "./ActivityFeed.astro";
import MarketCard from "./MarketCard.astro";
import RunRow from "./RunRow.astro";
import { INITIAL_SHOWN, MARKET_CAT_DEFS, MARKET_SORT_DEFS, sortMarketRuns, type FeedItem, type MarketRun } from "../lib/market";

type Props = { runs: MarketRun[]; feed: FeedItem[] };
const { runs, feed } = Astro.props;
const sorted = sortMarketRuns(runs, "newest");
const initial = sorted.slice(0, INITIAL_SHOWN);
const rest = Math.max(sorted.length - INITIAL_SHOWN, 0);
const integrations = [
  ...new Map(runs.flatMap((run) => run.tools.map((tool) => [tool.toLowerCase(), tool]))).values(),
].sort((a, b) => a.localeCompare(b, "en", { sensitivity: "base" }));
---

<section aria-labelledby="trendingH">
  <div class="section-head">
    <div>
      <h2 id="trendingH">On the board</h2>
      <p class="sub" id="boardSub">Verified jobs with evidence — not prompt-pack filler.</p>
    </div>
    <div class="tabs" id="board-tabs" role="tablist" aria-label="Board view">
      <button type="button" role="tab" id="tab-newest" aria-selected="true" aria-controls="board-runs" data-view="runs" data-sort="newest">Newest</button>
      <button type="button" role="tab" id="tab-patches" aria-selected="false" aria-controls="board-runs" data-view="runs" data-sort="patches">Most patched</button>
      <button type="button" role="tab" id="tab-activity" aria-selected="false" aria-controls="activity" data-view="activity">Live activity</button>
    </div>
  </div>
  <div id="board-runs" role="tabpanel" aria-labelledby="tab-newest">
    <div class="board-chrome">
      <label class="board-filter">
        <select id="catFilter" aria-label="Filter by category">
          {MARKET_CAT_DEFS.map((cat) => (
            <option value={cat.id}>{cat.id === "all" ? "Any category" : cat.name}</option>
          ))}
        </select>
      </label>
      <label class="board-filter">
        <select id="toolFilter" aria-label="Filter by integration">
          <option value="">Any integration</option>
          {integrations.map((tool) => (
            <option value={tool}>{tool}</option>
          ))}
        </select>
      </label>
      <a class="board-dir" href="/companies">Companies</a>
      <label class="board-filter">
        <select id="sortFilter" aria-label="Sort runs">
          {MARKET_SORT_DEFS.map((sort) => (
            <option value={sort.id} selected={sort.id === "newest"}>
              {sort.label}
            </option>
          ))}
        </select>
      </label>
      <span class="board-rule" aria-hidden="true"></span>
      <div class="layout-toggle" role="group" aria-label="Board layout">
        <button type="button" data-layout="table" aria-pressed="false">Table</button>
        <button type="button" data-layout="cards" aria-pressed="true">Cards</button>
      </div>
    </div>
    <div class="runs-table" id="runs-table" hidden>
      <table class="runs">
        <thead>
          <tr>
            <th scope="col">Job</th>
            <th scope="col">Category</th>
            <th scope="col">Integrations</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody id="runList">
          {
            initial.length ? (
              initial.map((run) => <RunRow run={run} />)
            ) : (
              <tr>
                <td class="empty" colspan="4">No Runs match that yet. File one and mint the next serial.</td>
              </tr>
            )
          }
        </tbody>
      </table>
    </div>
    <div class="job-cards" id="job-cards">
      {
        initial.length ? (
          initial.map((run) => <MarketCard run={run} />)
        ) : (
          <p class="empty">No Runs match that yet. File one and mint the next serial.</p>
        )
      }
    </div>
    <p class="loadmore" id="loadWrap" style={rest ? undefined : "display:none"}>
      <button type="button" id="loadMore">Load more Runs ↓ ({rest})</button>
    </p>
  </div>
  <ActivityFeed items={feed} />
</section>
