---
import RunRow from "./RunRow.astro";
import { INITIAL_SHOWN, sortMarketRuns, type MarketRun } from "../lib/market";

type Props = { runs: MarketRun[] };
const { runs } = Astro.props;
const sorted = sortMarketRuns(runs, "newest");
const initial = sorted.slice(0, INITIAL_SHOWN);
const rest = Math.max(sorted.length - INITIAL_SHOWN, 0);
---

<section aria-labelledby="trendingH">
  <div class="section-head">
    <div>
      <h2 id="trendingH">On the board</h2>
      <p class="sub">Verified jobs with evidence — not prompt-pack filler.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Sort runs">
      <button type="button" role="tab" aria-selected="true" data-sort="newest">Newest</button>
      <button type="button" role="tab" aria-selected="false" data-sort="patches">Most patched</button>
    </div>
  </div>
  <ul class="runs" id="runList">
    {
      initial.length ? (
        initial.map((run, i) => <RunRow run={run} idx={i + 1} />)
      ) : (
        <li class="empty">No Runs match that yet. File one and mint the next serial.</li>
      )
    }
  </ul>
  <p class="loadmore" id="loadWrap" style={rest ? undefined : "display:none"}>
    <button type="button" id="loadMore">Load more Runs ↓ ({rest})</button>
  </p>
</section>
