---
import { CAT_LABEL, catPath, type RunCatId } from "../lib/category";
import { houseLabel, publishedRunPath } from "../lib/format";
import { parseConnectors } from "../lib/tools";
import type { RunRow } from "../lib/types";

type Props = { runs: RunRow[]; cat?: RunCatId };
const { runs, cat } = Astro.props;
const catLabel = cat ? CAT_LABEL[cat] : null;
const moreHref = cat ? catPath(cat) : null;

function relatedSub(run: RunRow): string {
  const connectors = parseConnectors(run.connectors);
  if (connectors.length) return connectors.join(", ");
  if (run.house_number) return houseLabel(run.house_number);
  return "";
}
---

<section class="narrow run-more" aria-label="More Runs">
  <h2 id="more-runs">More Runs</h2>
  {
    moreHref && catLabel ? (
      <p class="run-more-more">
        <a href={moreHref}>More in {catLabel}</a>
      </p>
    ) : null
  }
  <ul class="run-more-grid" aria-labelledby="more-runs">
    {runs.map((run) => {
      const href = publishedRunPath(run);
      const sub = relatedSub(run);
      if (!href) return null;
      return (
        <li>
          <a class="run-more-card" href={href}>
            <span class="run-more-title">{run.title}</span>
            {sub ? <span class="run-more-sub">{sub}</span> : null}
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .run-more {
    margin-top: 2.75rem;
  }

  .run-more h2 {
    margin-top: 0;
  }

  .run-more-more {
    margin: -0.35rem 0 0.85rem;
  }

  .run-more-more a {
    font-family: var(--mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .run-more-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .run-more-grid > li {
    display: flex;
    min-width: 0;
  }

  .run-more-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.28rem;
    min-height: 6.4rem;
    width: 100%;
    padding: 1rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-2);
    color: inherit;
    text-decoration: none;
  }

  .run-more-card:hover,
  .run-more-card:focus-visible {
    border-color: var(--brass-dim);
    color: inherit;
  }

  .run-more-title {
    color: var(--fg);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .run-more-card:hover .run-more-title {
    color: var(--brass);
  }

  .run-more-sub {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  @media (width < 640px) {
    .run-more-grid {
      grid-template-columns: 1fr;
    }

    .run-more-card {
      min-height: 0;
    }
  }
</style>
