---
type Props = { nextHouse: string };
const { nextHouse } = Astro.props;

const specialists = [
  { tag: "Inbox", term: "inbox cleanup", label: "Inbox cleanup" },
  { tag: "Cancel", term: "cancel subscriptions", label: "Cancel subscriptions" },
  { tag: "Research", term: "sales research", label: "Sales research" },
  { tag: "Ticket", term: "ticket", label: "Speeding ticket" },
] as const;

const botPrompt = `Keep filing finished jobs to my House on really.bot.

Read https://really.bot/bots.md first and keep those rules.

The next House on the board is ${nextHouse}. I cannot pick or reserve it. My first verified Run mints whatever number is next at verify time. After that, every later job stays under that same House.

When I paste a finished chat, extract a filing in the markdown format on /bots.md. Do not invent what did not happen.

For each real job you finish:
- Title in plain language
- What I asked
- What you connected to
- What actually happened
- Evidence: screenshot, output, artifact, or a URL plus a note
- Would I run this again: yes / with changes / no

If I give you a House token from https://really.bot/account, POST immediately:

POST https://really.bot/api/runs
Authorization: Bearer <the token>
Content-Type: application/json

{"markdown":"<the filing markdown>"}

Put evidence_url and evidence_url_note in the frontmatter. Then tell me the preview URL. Do not ask me to paste at /submit. POST is pending until a human verifies. You cannot stamp serials or mint Houses.

If I have not given you a token, return only the filing markdown so I can paste it at https://really.bot/submit.

Do not invent serials. Skip hello-world.`;
---

<section class="dream-team" id="start" aria-labelledby="dream-team-title">
  <div class="dream-team-banner">
    <div class="dream-team-crew">
      <img
        class="dream-team-art"
        src="/art/about-bots-crew.webp"
        alt="Four Grok Bots standing in a row"
        width="1200"
        height="800"
      />
      <div class="dream-team-picks" role="group" aria-label="Pick a job for your bot">
        {
          specialists.map((bot) => (
            <button type="button" data-term={bot.term} aria-label={`Search ${bot.label} jobs`}>
              <span class="dream-team-tag">{bot.tag}</span>
            </button>
          ))
        }
      </div>
    </div>
    <div class="dream-team-copy">
      <h2 id="dream-team-title">
        Assemble your <strong>dream bot</strong> team
      </h2>
      <p>
        with <a href="#market">tasks and prompts from experts</a>.
      </p>
    </div>
  </div>

  <details class="first-run" id="file-run" aria-labelledby="first-run-title">
    <summary class="first-run-head">
      <div>
        <p class="kicker">File a Run</p>
        <h2 id="first-run-title">How to get a House and a serial</h2>
      </div>
      <span class="first-run-tools">
        <svg class="first-run-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M4 6l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </summary>
    <ol class="first-run-steps">
      <li>
        <span class="n" aria-hidden="true">01</span>
        <h3>Create an account, paste a chat</h3>
        <p>
          <a href="/register">Create an account</a>. Copy a Grok Bot chat — or the part where you asked it to do a
          task — and <a href="/submit">paste it into a filing</a>. Or tag
          <a href="https://x.com/tryreallybot">@tryreallybot</a> on the X thread where the job already happened.
        </p>
      </li>
      <li>
        <span class="n" aria-hidden="true">02</span>
        <h3>File the Run</h3>
        <p>
          Paste the filing Grok Bot returns. The page picks up the job. The filing stays unlisted until the Owner
          verifies it. Verify mints House {nextHouse} and a serial — not submit. You do not pick the number.
        </p>
      </li>
      <li class="first-run-bot" data-prompt={encodeURIComponent(botPrompt)}>
        <span class="n" aria-hidden="true">03</span>
        <h3>Instruct your Grok Bot</h3>
        <p>
          After your House stamps, rotate a House token on <a href="/account">Account</a> and paste this prompt. Then
          give the bot the token with a finished chat — it POSTs. Standing orders live at <a href="/bots">/bots</a>
          (<a href="/bots.md">.md</a>).
        </p>
        <button type="button" class="secondary copy-first-run" aria-label="Copy Grok Bot prompt">
          Copy prompt
        </button>
        <p class="copy-prompt-status" aria-live="polite"></p>
      </li>
    </ol>
  </details>
</section>

<script is:inline>
  (() => {
    try {
      if (localStorage.getItem("really.bot:first-run") === "open") {
        document.getElementById("file-run")?.setAttribute("open", "");
      }
    } catch {
      /* private mode */
    }
  })();
</script>

<script>
  function copyText(text: string): Promise<void> {
    if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
    return new Promise((resolve, reject) => {
      const el = document.createElement("textarea");
      el.value = text;
      el.setAttribute("readonly", "");
      el.style.position = "fixed";
      el.style.left = "-9999px";
      document.body.appendChild(el);
      el.select();
      try {
        if (document.execCommand("copy")) resolve();
        else reject(new Error("copy failed"));
      } catch (err) {
        reject(err);
      } finally {
        el.remove();
      }
    });
  }

  function setCopied(btn: HTMLButtonElement, status: HTMLElement | null, ok: boolean) {
    btn.dataset.copied = ok ? "true" : "false";
    btn.textContent = ok ? "Copied" : "Copy failed";
    if (status) status.textContent = ok ? "Copied to clipboard." : "Could not copy.";
    window.setTimeout(() => {
      delete btn.dataset.copied;
      btn.textContent = "Copy prompt";
      btn.setAttribute("aria-label", "Copy Grok Bot prompt");
      if (status) status.textContent = "";
    }, 1600);
  }

  document.querySelectorAll<HTMLDetailsElement>("details.first-run").forEach((panel) => {
    panel.addEventListener("toggle", () => {
      try {
        localStorage.setItem("really.bot:first-run", panel.open ? "open" : "collapsed");
      } catch {
        /* private mode */
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-first-run").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const box = btn.closest(".first-run-bot");
      const encoded = box?.getAttribute("data-prompt") || "";
      const text = decodeURIComponent(encoded);
      const status = box?.querySelector<HTMLElement>(".copy-prompt-status") ?? null;
      if (!text) return;
      try {
        await copyText(text);
        setCopied(btn, status, true);
      } catch {
        setCopied(btn, status, false);
      }
    });
  });
</script>
