---
type Props = { nextHouse: string };
const { nextHouse } = Astro.props;

const botPrompt = `Keep filing finished jobs to my House on really.bot.

Read https://really.bot/bots.md first and keep those rules.

The next House on the board is ${nextHouse}. I cannot pick or reserve it. My first verified Run mints whatever number is next at verify time. After that, every later job stays under that same House.

When I paste a finished chat, extract a filing in the markdown format on /bots.md so I can paste it at https://really.bot/submit. Do not invent what did not happen.

For each real job you finish:
- Title in plain language
- What I asked
- What you connected to
- What actually happened
- Evidence: screenshot, output, artifact, or a URL plus a note
- Would I run this again: yes / with changes / no

Submit at https://really.bot/submit, or POST https://really.bot/api/runs with Authorization: Bearer plus the House token from https://really.bot/account.

Do not invent serials. Skip hello-world.`;
---

<details class="first-run" id="start" open aria-labelledby="first-run-title">
  <summary class="first-run-head">
    <div>
      <p class="kicker">Start here</p>
      <h2 id="first-run-title">Your first Grok Bot Run</h2>
    </div>
    <span class="first-run-tools">
      <span class="tiny first-run-house">Next House <b>{nextHouse}</b></span>
      <svg class="first-run-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M4 6l4 4 4-4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </summary>
  <ol class="first-run-steps">
    <li>
      <span class="n" aria-hidden="true">01</span>
      <h3>Create an account, paste a chat</h3>
      <p>
        <a href="/register">Create an account</a>. Copy a Grok Bot chat — or the part where you asked it to do a
        task — and <a href="/submit">paste it into a filing</a>. That is the job.
      </p>
    </li>
    <li>
      <span class="n" aria-hidden="true">02</span>
      <h3>File the Run</h3>
      <p>
        Add what it connected to, what it actually did, evidence, and would-run-again. The filing stays unlisted
        until the Owner verifies it. Verify mints House {nextHouse} and a serial — not submit. You do not pick the
        number.
      </p>
    </li>
    <li class="first-run-bot" data-prompt={encodeURIComponent(botPrompt)}>
      <span class="n" aria-hidden="true">03</span>
      <h3>Instruct your Grok Bot</h3>
      <p>
        After your House stamps, tell Grok Bot to keep adding finished jobs under that number. Paste this prompt.
        Standing orders live at <a href="/bots">/bots</a> (<a href="/bots.md">.md</a>).
      </p>
      <button type="button" class="secondary copy-first-run" aria-label="Copy Grok Bot prompt">
        Copy prompt
      </button>
      <p class="copy-prompt-status" aria-live="polite"></p>
    </li>
  </ol>
</details>

<script is:inline>
  (() => {
    try {
      if (localStorage.getItem("really.bot:first-run") === "collapsed") {
        document.getElementById("start")?.removeAttribute("open");
      }
    } catch {
      /* private mode */
    }
  })();
</script>

<script>
  function copyText(text: string): Promise<void> {
    if (navigator.clipboard?.writeText) return navigator.clipboard.writeText(text);
    return new Promise((resolve, reject) => {
      const el = document.createElement("textarea");
      el.value = text;
      el.setAttribute("readonly", "");
      el.style.position = "fixed";
      el.style.left = "-9999px";
      document.body.appendChild(el);
      el.select();
      try {
        if (document.execCommand("copy")) resolve();
        else reject(new Error("copy failed"));
      } catch (err) {
        reject(err);
      } finally {
        el.remove();
      }
    });
  }

  function setCopied(btn: HTMLButtonElement, status: HTMLElement | null, ok: boolean) {
    btn.dataset.copied = ok ? "true" : "false";
    btn.textContent = ok ? "Copied" : "Copy failed";
    if (status) status.textContent = ok ? "Copied to clipboard." : "Could not copy.";
    window.setTimeout(() => {
      delete btn.dataset.copied;
      btn.textContent = "Copy prompt";
      btn.setAttribute("aria-label", "Copy Grok Bot prompt");
      if (status) status.textContent = "";
    }, 1600);
  }

  document.querySelectorAll<HTMLDetailsElement>("details.first-run").forEach((panel) => {
    panel.addEventListener("toggle", () => {
      try {
        localStorage.setItem("really.bot:first-run", panel.open ? "open" : "collapsed");
      } catch {
        /* private mode */
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".copy-first-run").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const box = btn.closest(".first-run-bot");
      const encoded = box?.getAttribute("data-prompt") || "";
      const text = decodeURIComponent(encoded);
      const status = box?.querySelector<HTMLElement>(".copy-prompt-status") ?? null;
      if (!text) return;
      try {
        await copyText(text);
        setCopied(btn, status, true);
      } catch {
        setCopied(btn, status, false);
      }
    });
  });
</script>
