---
import type { FeedItem } from "../lib/market";

type Props = { items: FeedItem[] };
const { items } = Astro.props;
---

<div class="panel board-activity" id="activity" role="tabpanel" aria-labelledby="tab-activity" hidden>
  <div class="panel-head">
    <a href="/changelog">View all</a>
  </div>
  <ul class="feed" id="feed">
    {
      items.length === 0 ? (
        <li class="empty">Nothing on the log yet.</li>
      ) : (
        items.map((item) => (
          <li>
            <span class="fi" aria-hidden="true">
              {item.i}
            </span>
            <span>
              <b>
                {item.href ? <a href={item.href}>{item.b}</a> : item.b}
              </b>
              <small>{item.s}</small>
            </span>
            <time>{item.t}</time>
          </li>
        ))
      )
    }
  </ul>
</div>
