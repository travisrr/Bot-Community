---
import HouseLot from "./HouseLot.astro";
import { houseGrid, type ClaimedHouse } from "../lib/city";

type Props = {
  claimed: ClaimedHouse[];
  nextHouse: number;
};
const { claimed, nextHouse } = Astro.props;
const lots = houseGrid(claimed, nextHouse);
---

<section class="px-grid" aria-label="Minted Houses">
  {lots.map((lot) => <HouseLot lot={lot} />)}
</section>
