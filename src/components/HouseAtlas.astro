---
import HouseLot from "./HouseLot.astro";
import {
  BLOCKS_PER_NEIGHBORHOOD,
  HOUSES_PER_STREET,
  neighborhoodIndexFor,
  plattedNeighborhoods,
  STREETS_PER_BLOCK,
  type ClaimedHouse,
} from "../lib/city";
import { houseLabel, housePath, padHouse } from "../lib/format";

type Props = {
  claimed: ClaimedHouse[];
  nextHouse: number;
};
const { claimed, nextHouse } = Astro.props;
const neighborhoods = plattedNeighborhoods(claimed, nextHouse);
const nextNeighborhood = neighborhoodIndexFor(Math.max(nextHouse, 1)) + 1;
const nextLabel = padHouse(nextHouse);
const minted = claimed.length;
const currentHood = neighborhoods[neighborhoods.length - 1];
---

<section class="atlas" id="atlas" aria-label="House atlas">
  <div class="atlas-legend" aria-hidden="true">
    <span><b>{HOUSES_PER_STREET}</b> lots → street</span>
    <span><b>{STREETS_PER_BLOCK}</b> streets → block</span>
    <span><b>{BLOCKS_PER_NEIGHBORHOOD}</b> blocks → neighborhood</span>
    <span>Houses grow a story as you file Runs</span>
  </div>

  <div class="atlas-city" data-next-hood={String(nextNeighborhood)}>
    {
      neighborhoods.map((hood) => (
        <section class="atlas-hood platted" data-hood={String(hood.index)} aria-labelledby={`hood-${hood.index}`}>
          <header class="atlas-gate">
            <p class="atlas-kicker">Neighborhood {padHouse(hood.index + 1)}</p>
            <h2 id={`hood-${hood.index}`}>{hood.name}</h2>
            <p class="atlas-range">Houses {hood.rangeLabel}</p>
          </header>
          {hood.blocks.map((block) => (
            <div class="atlas-block">
              <p class="atlas-block-sign">
                Block {block.letter}
                <span>of {BLOCKS_PER_NEIGHBORHOOD}</span>
              </p>
              {block.streets.map((street) => (
                <div class="atlas-street">
                  <div class="atlas-lots">
                    {street.lots.map((lot) => (
                      <HouseLot lot={lot} />
                    ))}
                  </div>
                  <div class="atlas-curb" />
                  <div class="atlas-road">
                    <span class="lamp" />
                    <span class="road-name">{street.name}</span>
                    <span class="road-range">{street.rangeLabel}</span>
                    <span class="lamp" />
                  </div>
                </div>
              ))}
              <div class="atlas-cross" aria-hidden="true">
                <span />
              </div>
            </div>
          ))}
        </section>
      ))
    }
  </div>

  <div class="atlas-sentinel" data-atlas-sentinel>
    <p>The plat continues. Empty lots stay numbered. Nobody lives there yet.</p>
  </div>
</section>

{
  claimed.length > 0 && (
    <details class="atlas-list">
      <summary>Minted as a list</summary>
      <ul class="plain">
        {claimed.map((h) => (
          <li>
            <a href={housePath(h.house_number)}>{houseLabel(h.house_number)}</a>
            — {h.display_name}
            {h.username ? ` (@${h.username})` : ""}
          </li>
        ))}
      </ul>
    </details>
  )
}

<p class="atlas-next muted">
  {minted === 0 ? (
    <>
      None minted yet. The first verified Run claims <a href="/submit">House {nextLabel}</a> on{" "}
      {currentHood?.blocks[0]?.streets[0]?.name ?? "Serial Street"}.
    </>
  ) : (
    <>
      {minted} minted. Next lot is <a href="/submit">House {nextLabel}</a>
      {currentHood ? ` in ${currentHood.name}` : ""}.
    </>
  )}
</p>

<script>
  import { BLOCKS_PER_NEIGHBORHOOD, neighborhoodAt, type ClaimedHouse } from "../lib/city";
  import { padHouse } from "../lib/format";

  const city = document.querySelector(".atlas-city") as HTMLElement | null;
  const sentinel = document.querySelector("[data-atlas-sentinel]") as HTMLElement | null;
  if (city && sentinel) {
    const emptyClaimed: Map<number, ClaimedHouse> = new Map();
    let nextHood = Number(city.dataset.nextHood || "1");
    let extra = 0;
    const extraCap = 8;
    let busy = false;

    function esc(s: string): string {
      return s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] || c);
    }

    function lotHtml(n: number, variant: number, roof: string, chimney: boolean): string {
      const label = padHouse(n);
      const chimneyHtml = chimney ? `<span class="chimney"></span>` : "";
      return `<div class="lot unplatted v${variant} stories-1" aria-hidden="true">
        <span class="house">
          <span class="roof-wrap ${esc(roof)}">${chimneyHtml}<span class="roof"></span></span>
          <span class="facade">
            <span class="wins"><span class="win"></span><span class="win"></span></span>
            <span class="door"></span>
            <span class="plate">${label}</span>
          </span>
        </span>
        <span class="lot-meta ghost-meta">${label}</span>
      </div>`;
    }

    function hoodHtml(index: number): string {
      const hood = neighborhoodAt(index, emptyClaimed, 0, false);
      const blocks = hood.blocks
        .map((block) => {
          const streets = block.streets
            .map((street) => {
              const lots = street.lots
                .map((lot) => lotHtml(lot.n, lot.look.variant, lot.look.roof, lot.look.chimney))
                .join("");
              return `<div class="atlas-street">
                <div class="atlas-lots">${lots}</div>
                <div class="atlas-curb"></div>
                <div class="atlas-road">
                  <span class="lamp"></span>
                  <span class="road-name">${esc(street.name)}</span>
                  <span class="road-range">${esc(street.rangeLabel)}</span>
                  <span class="lamp"></span>
                </div>
              </div>`;
            })
            .join("");
          return `<div class="atlas-block">
            <p class="atlas-block-sign">Block ${esc(block.letter)}<span>of ${BLOCKS_PER_NEIGHBORHOOD}</span></p>
            ${streets}
            <div class="atlas-cross" aria-hidden="true"><span></span></div>
          </div>`;
        })
        .join("");
      return `<section class="atlas-hood unplatted" data-hood="${index}" aria-label="${esc(hood.name)}">
        <header class="atlas-gate">
          <p class="atlas-kicker">Neighborhood ${padHouse(hood.index + 1)} · unplatted</p>
          <h2>${esc(hood.name)}</h2>
          <p class="atlas-range">Houses ${esc(hood.rangeLabel)}</p>
        </header>
        ${blocks}
      </section>`;
    }

    let observer: IntersectionObserver;
    function platNext(): void {
      if (busy || extra >= extraCap) return;
      busy = true;
      city.insertAdjacentHTML("beforeend", hoodHtml(nextHood));
      nextHood += 1;
      extra += 1;
      busy = false;
      if (extra >= extraCap) {
        observer.disconnect();
        sentinel.innerHTML =
          "<p>The numbered grid keeps going. File a Run and the next House lands on the next empty lot.</p>";
      }
    }

    observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) platNext();
      },
      { rootMargin: "800px 0px" },
    );
    observer.observe(sentinel);
  }
</script>
