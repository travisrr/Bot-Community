---
import { roleLabel } from "../lib/format";
import type { PublicUser } from "../lib/types";

type Props = {
  current: "filings" | "patches" | "qa" | "discovery";
  pendingFilings: number;
  openPatches: number;
  openQa?: number;
  discoveryCount?: number;
  user: PublicUser;
};

const { current, pendingFilings, openPatches, openQa = 0, discoveryCount = 0, user } = Astro.props;
const handle = user.x_handle || user.username;
---

<p class="muted">
  Signed in as {roleLabel(user.role)}
  {handle ? ` · @${handle.replace(/^@/, "")}` : ""}
</p>
<nav class="admin-nav" aria-label="Admin">
  <a href="/admin" aria-current={current === "filings" ? "page" : undefined}>
    Filings{pendingFilings ? ` (${pendingFilings})` : ""}
  </a>
  <a href="/admin/patches" aria-current={current === "patches" ? "page" : undefined}>
    Patches{openPatches ? ` (${openPatches})` : ""}
  </a>
  <a href="/admin/qa" aria-current={current === "qa" ? "page" : undefined}>
    QA{openQa ? ` (${openQa})` : ""}
  </a>
  <a href="/admin/discovery" aria-current={current === "discovery" ? "page" : undefined}>
    Prompts{discoveryCount ? ` (${discoveryCount})` : ""}
  </a>
</nav>
