---
import type { MarketPayload } from "../lib/market";

type Props = { payload: MarketPayload };
const { payload } = Astro.props;
const json = JSON.stringify(payload).replaceAll("<", "\\u003c");
---

<script id="market-data" type="application/json" set:html={json} />
<script>
  import { toolsHtml } from "../lib/tools";

  type CatId = "all" | "work" | "research" | "sales" | "personal" | "coding" | "money" | "legal";
  type SortKey = "az" | "newest" | "patches";
  type BoardView = "runs" | "activity";
  type BoardLayout = "table" | "cards";
  type MarketCat = { id: CatId; glyph: string; name: string; n: number };
  type MarketRun = {
    serial: string;
    href: string;
    rev: number;
    cat: Exclude<CatId, "all">;
    catLabel: string;
    house: string;
    patches: number;
    age: number;
    title: string;
    desc: string;
    tools: string[];
    source: string;
    sourceHref: string | null;
  };

  const raw = document.getElementById("market-data")?.textContent || "{}";
  const payload = JSON.parse(raw) as { runs: MarketRun[]; cats: MarketCat[] };
  const RUNS = payload.runs || [];
  const CATS = payload.cats || [];
  const EMPTY = "No Runs match that yet. File one and mint the next serial.";

  const state: { cat: CatId; q: string; tool: string; sort: SortKey; shown: number; view: BoardView; layout: BoardLayout } = {
    cat: "all",
    q: "",
    tool: "",
    sort: "newest",
    shown: 8,
    view: "runs",
    layout: "cards",
  };

  const $ = (s: string) => document.querySelector(s) as HTMLElement | null;
  const esc = (s: string) =>
    String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] || c);

  function filtered(): MarketRun[] {
    const q = state.q.trim().toLowerCase();
    const tool = state.tool.trim().toLowerCase();
    const out = RUNS.filter((r) => {
      if (state.cat !== "all" && r.cat !== state.cat) return false;
      if (tool && !r.tools.some((name) => name.toLowerCase() === tool)) return false;
      if (!q) return true;
      return `${r.title} ${r.desc} ${r.catLabel} ${r.tools.join(" ")} ${r.serial} ${r.source}`.toLowerCase().includes(q);
    });
    switch (state.sort) {
      case "az":
        return out.sort((a, b) => a.title.localeCompare(b.title, "en", { sensitivity: "base" }) || a.age - b.age);
      case "newest":
        return out.sort((a, b) => a.age - b.age || b.patches - a.patches);
      case "patches":
        return out.sort((a, b) => b.patches - a.patches || a.age - b.age);
      default: {
        const _never: never = state.sort;
        return _never;
      }
    }
  }

  function selectedTab(): HTMLElement | null {
    switch (state.view) {
      case "activity":
        return document.querySelector("#board-tabs [data-view='activity']");
      case "runs":
        return document.querySelector(`#board-tabs [data-sort='${state.sort}']`);
      default: {
        const _never: never = state.view;
        return _never;
      }
    }
  }

  function syncHash() {
    if (state.view === "activity") {
      if (location.hash !== "#activity") history.replaceState(null, "", `${location.pathname}${location.search}#activity`);
      return;
    }
    if (location.hash === "#activity") history.replaceState(null, "", `${location.pathname}${location.search}#market`);
  }

  function applyView() {
    const runsPanel = $("#board-runs");
    const activityPanel = $("#activity");
    const heading = $("#trendingH");
    const sub = $("#boardSub");
    document.querySelectorAll("#board-tabs [role='tab']").forEach((tab) => {
      tab.setAttribute("aria-selected", tab === selectedTab() ? "true" : "false");
    });
    switch (state.view) {
      case "activity":
        if (runsPanel) runsPanel.hidden = true;
        if (activityPanel) activityPanel.hidden = false;
        if (heading) heading.textContent = "Live activity";
        if (sub) sub.textContent = "Serials, Houses, and patches as they land.";
        return;
      case "runs":
        if (runsPanel) {
          runsPanel.hidden = false;
          const tab = selectedTab();
          runsPanel.setAttribute("aria-labelledby", tab?.id || "trendingH");
        }
        if (activityPanel) activityPanel.hidden = true;
        if (sub) sub.textContent = "Verified jobs with evidence — not prompt-pack filler.";
        applyLayout();
        return;
      default: {
        const _never: never = state.view;
        return _never;
      }
    }
  }

  function applyLayout() {
    const table = $("#runs-table");
    const cards = $("#job-cards");
    switch (state.layout) {
      case "table":
        if (table) table.hidden = false;
        if (cards) cards.hidden = true;
        break;
      case "cards":
        if (table) table.hidden = true;
        if (cards) cards.hidden = false;
        break;
      default: {
        const _never: never = state.layout;
        return _never;
      }
    }
    document.querySelectorAll(".layout-toggle [data-layout]").forEach((btn) => {
      const el = btn as HTMLElement;
      el.setAttribute("aria-pressed", el.dataset.layout === state.layout ? "true" : "false");
    });
  }

  function sourceHtml(r: MarketRun, className: string): string {
    return r.sourceHref
      ? `<a class="${className}" href="${esc(r.sourceHref)}">${esc(r.source)}</a>`
      : `<span class="${className}">${esc(r.source)}</span>`;
  }

  function rowHtml(r: MarketRun): string {
    const tools = r.tools.length
      ? `<div class="tools">${toolsHtml(r.tools, esc)}</div>`
      : `<span class="tools-empty">—</span>`;
    return `
      <tr class="run">
        <td class="job">
          <a class="job-title" href="${esc(r.href)}">${esc(r.title)}</a>
          <span class="job-id">${esc(r.serial)}.r${r.rev}</span>
        </td>
        <td class="cat-cell"><span class="pill" data-cat="${esc(r.cat)}">${esc(r.catLabel)}</span></td>
        <td class="tools-cell">${tools}</td>
        <td class="source-cell">${sourceHtml(r, "run-source")}</td>
      </tr>`;
  }

  function cardHtml(r: MarketRun): string {
    const tools = r.tools.length
      ? `<div class="job-card-tools">${toolsHtml(r.tools, esc)}</div>`
      : "";
    return `<article class="job-card">
      <h3 class="job-card-title"><a href="${esc(r.href)}">${esc(r.title)}</a></h3>
      <div class="job-card-desc"><p>${esc(r.desc)}</p></div>
      ${tools}
      ${sourceHtml(r, "job-card-source")}
    </article>`;
  }

  function render() {
    applyView();
    if (state.view === "activity") return;

    const all = filtered();
    const list = all.slice(0, state.shown);
    const tbody = $("#runList");
    const cards = $("#job-cards");
    if (tbody) {
      tbody.innerHTML = !all.length
        ? `<tr><td class="empty" colspan="4">${EMPTY}</td></tr>`
        : list.map(rowHtml).join("");
    }
    if (cards) {
      cards.innerHTML = !all.length
        ? `<p class="empty">${EMPTY}</p>`
        : list.map(cardHtml).join("");
    }

    const rest = Math.max(all.length - state.shown, 0);
    const loadWrap = $("#loadWrap");
    const loadMore = $("#loadMore");
    if (loadWrap) loadWrap.style.display = rest ? "block" : "none";
    if (loadMore) loadMore.textContent = `Load more Runs ↓ (${rest})`;
    const heading = $("#trendingH");
    if (heading) {
      heading.textContent = state.q
        ? `Results for "${state.q}"`
        : state.cat === "all"
          ? "On the board"
          : (CATS.find((c) => c.id === state.cat)?.name ?? "On the board");
    }
    syncSortControl();
  }

  function syncCatControls() {
    const select = $("#catFilter") as HTMLSelectElement | null;
    if (select) select.value = state.cat;
    document.querySelectorAll(".cat").forEach((c) => {
      const el = c as HTMLElement;
      el.setAttribute("aria-pressed", el.dataset.cat === state.cat ? "true" : "false");
    });
  }

  function syncSortControl() {
    const select = $("#sortFilter") as HTMLSelectElement | null;
    if (select) select.value = state.sort;
  }

  function setCat(cat: CatId) {
    state.cat = cat;
    state.view = "runs";
    state.shown = 8;
    syncCatControls();
    syncHash();
    render();
  }

  $("#cats")?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest(".cat") as HTMLElement | null;
    if (!b) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    setCat((b.dataset.cat || "all") as CatId);
  });

  $("#board-tabs")?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button[role='tab']") as HTMLElement | null;
    if (!b) return;
    const view = b.dataset.view === "activity" ? "activity" : "runs";
    state.view = view;
    if (view === "runs") {
      const sort = b.dataset.sort;
      if (sort === "az" || sort === "newest" || sort === "patches") state.sort = sort;
      state.shown = 8;
    }
    syncHash();
    render();
  });

  $(".layout-toggle")?.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest("button[data-layout]") as HTMLElement | null;
    if (!b) return;
    const layout = b.dataset.layout;
    if (layout !== "table" && layout !== "cards") return;
    state.layout = layout;
    state.view = "runs";
    syncHash();
    render();
  });

  $("#toolFilter")?.addEventListener("change", (e) => {
    const select = e.currentTarget as HTMLSelectElement;
    state.tool = select.value || "";
    state.view = "runs";
    state.shown = 8;
    syncHash();
    render();
  });

  $("#catFilter")?.addEventListener("change", (e) => {
    const select = e.currentTarget as HTMLSelectElement;
    const cat = select.value || "all";
    setCat(cat as CatId);
  });

  $("#sortFilter")?.addEventListener("change", (e) => {
    const select = e.currentTarget as HTMLSelectElement;
    const sort = select.value;
    if (sort !== "az" && sort !== "newest" && sort !== "patches") return;
    state.sort = sort;
    state.view = "runs";
    state.shown = 8;
    syncHash();
    render();
  });

  const doSearch = () => {
    const input = $("#q") as HTMLInputElement | null;
    state.q = input?.value || "";
    state.view = "runs";
    state.shown = 8;
    syncHash();
    render();
  };

  $("#q")?.addEventListener("input", doSearch);
  $("#searchBtn")?.addEventListener("click", () => {
    doSearch();
    $("#market")?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
  $("#loadMore")?.addEventListener("click", () => {
    state.shown += 8;
    render();
  });

  addEventListener("keydown", (e) => {
    const input = $("#q") as HTMLInputElement | null;
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      input?.focus();
      input?.select();
    }
    if (e.key === "Escape" && document.activeElement === input) {
      if (input) input.value = "";
      doSearch();
      input?.blur();
    }
  });

  const applyHash = () => {
    if (location.hash === "#activity") {
      if (state.view === "activity") return;
      state.view = "activity";
      render();
      return;
    }
    if (state.view !== "activity") return;
    if (location.hash !== "" && location.hash !== "#market" && location.hash !== "#top") return;
    state.view = "runs";
    render();
  };
  applyHash();
  addEventListener("hashchange", applyHash);
</script>
