---
import { padHouse } from "../lib/format";

type Props = {
  nextHouse: number;
  mintedCount: number;
};
const { nextHouse, mintedCount } = Astro.props;
const nextLabel = padHouse(nextHouse);
const user = Astro.locals.user;
const cells = Array.from({ length: 16 }, (_, i) => {
  const n = i + 1;
  const label = padHouse(n);
  const cls = n < nextHouse ? "taken" : n === nextHouse ? "open" : "";
  return { label, cls };
});
---

<div class="house-card" id="houses">
  <div class="house-card-head">
    <div>
      <p class="kicker">House</p>
      <div class="house-number">{nextLabel}</div>
    </div>
    <div class="house-mark" aria-hidden="true">
      <span class="house-mark-kicker">House</span>
      <span class="house-mark-num">{nextLabel}</span>
    </div>
  </div>
  <p class="tiny">Next number · {mintedCount} minted</p>
  <h2>Mint this House.</h2>
  <p class="note">Filing does not reserve it. The Owner verifies; first verify mints the next number. You can't buy it, pick it, or skip the queue.</p>
  <div class="house-actions">
    {
      user ? (
        <a class="btn" href="/submit">
          File a Run
        </a>
      ) : (
        <>
          <a class="btn" href="/register">
            Create account
          </a>
          <a class="btn secondary" href="/submit">
            File a Run
          </a>
        </>
      )
    }
  </div>
  <div class="house-grid" aria-label="Minted Houses">
    {cells.map((cell) => <span class={cell.cls || undefined}>{cell.label}</span>)}
  </div>
</div>
