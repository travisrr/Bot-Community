---
import HouseSprite from "./HouseSprite.astro";
import { DECO_COUNT, houseCardCells, spriteForLot } from "../lib/city";
import { padHouse } from "../lib/format";

type Props = {
  nextHouse: number;
  mintedCount: number;
};
const { nextHouse, mintedCount } = Astro.props;
const nextLabel = padHouse(nextHouse);
const user = Astro.locals.user;
const sprite = spriteForLot(nextHouse, "minted", DECO_COUNT);
const cells = houseCardCells(nextHouse);
---

<div class="house-card" id="houses">
  <div class="house-card-head">
    <div>
      <p class="kicker">House</p>
      <div class="house-number">{nextLabel}</div>
    </div>
    <div class="house-preview-wrap">
      <HouseSprite sprite={sprite} class="house-preview" />
      <a class="house-see" href="/houses">see houses</a>
    </div>
  </div>
  <p class="tiny">Next number · {mintedCount} built</p>
  <h2>Every bot needs a home.</h2>
  <p class="note">Submit your first bot job. We verify it for completeness and results. Once verified, your House gets built, your bots move in, and you can submit more bot jobs.</p>
  <p class="note">You can't buy a House, choose one, or skip the line.</p>
  <div class="house-actions">
    {
      user ? (
        <a class="btn" href="/submit">
          Submit a Bot Job
        </a>
      ) : (
        <>
          <a class="btn" href="/register">
            Create account
          </a>
          <a class="btn secondary" href="/submit">
            Submit a Bot Job
          </a>
        </>
      )
    }
  </div>
  <div class="house-grid" aria-label="Built Houses">
    {
      cells.map((cell) => (
        <span class={cell.kind === "empty" ? undefined : cell.kind}>{padHouse(cell.n)}</span>
      ))
    }
  </div>
</div>
