---
import { mediaPath } from "../lib/site";
---

<div class="hero-main">
  <h1>
    <img class="grok-bot-mark" src={mediaPath("/grok-bot.svg")} width="40" height="32" alt="" />
    <span>The #1 Grok Bot repository <em>(...built for the Agentic Age)</em></span>
  </h1>
  <div class="searchbar">
    <span class="icon" aria-hidden="true">⌕</span>
    <input id="q" type="search" placeholder="What do you need your bot to do?" aria-label="Search jobs" autocomplete="off" />
    <button id="searchBtn" type="button">Search</button>
  </div>
  <p class="hero-use-cases">
    <a href="/grok-bot-use-cases">Grok Bot use cases</a>
  </p>
  <slot />
</div>
