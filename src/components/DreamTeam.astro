---
const crew = [
  {
    src: "/art/dream-bot-chief.webp",
    title: "Chief of Staff",
    alt: "Coral round Grok Bot waving",
    width: 298,
    height: 394,
  },
  {
    src: "/art/dream-bot-legal.webp",
    title: "Head of Legal",
    alt: "Gold wheeled Grok Bot",
    width: 214,
    height: 515,
  },
  {
    src: "/art/dream-bot-cto.webp",
    title: "CTO",
    alt: "Teal Grok Bot holding a folder",
    width: 246,
    height: 407,
  },
  {
    src: "/art/dream-bot-marketing.webp",
    title: "Marketing Executive",
    alt: "Violet Grok Bot holding a stamp",
    width: 346,
    height: 350,
  },
];
---

<section class="dream-team" id="start" aria-labelledby="dream-team-title">
  <div class="dream-team-banner">
    <ul class="dream-team-crew">
      {
        crew.map((bot) => (
          <li class="dream-team-bot">
            <img src={bot.src} alt={bot.alt} width={bot.width} height={bot.height} />
            <p class="dream-team-role">{bot.title}</p>
          </li>
        ))
      }
    </ul>
    <div class="dream-team-copy">
      <h2 id="dream-team-title">
        Assemble your <strong>dream bot</strong> team
      </h2>
      <p>with tasks and prompts from experts.</p>
    </div>
  </div>
</section>
