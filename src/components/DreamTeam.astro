---
import { mediaPath } from "../lib/site";

const crew = [
  {
    src: mediaPath("/art/dream-bot-chief.webp"),
    title: "Chief of Staff",
    alt: "Coral round Grok Bot waving",
    width: 303,
    height: 382,
  },
  {
    src: mediaPath("/art/dream-bot-legal.webp"),
    title: "Head of Legal",
    alt: "Gold wheeled Grok Bot",
    width: 206,
    height: 502,
  },
  {
    src: mediaPath("/art/dream-bot-cto.webp"),
    title: "CTO",
    alt: "Teal Grok Bot holding a folder",
    width: 242,
    height: 393,
  },
  {
    src: mediaPath("/art/dream-bot-marketing.webp"),
    title: "Marketing Executive",
    alt: "Violet Grok Bot holding a stamp",
    width: 342,
    height: 337,
  },
];
---

<section class="dream-team" id="start" aria-labelledby="dream-team-title">
  <div class="dream-team-banner">
    <ul class="dream-team-crew">
      {
        crew.map((bot, i) => (
          <li class="dream-team-bot">
            <img
              src={bot.src}
              alt={bot.alt}
              width={bot.width}
              height={bot.height}
              decoding="async"
              fetchpriority={i === 0 ? "high" : "low"}
            />
            <p class="dream-team-role">{bot.title}</p>
          </li>
        ))
      }
    </ul>
    <div class="dream-team-copy">
      <h2 id="dream-team-title">
        Assemble your <strong>dream bot team</strong>
      </h2>
      <p>with tasks and prompts from experts.</p>
      <p class="dream-team-lede">
        See what other people’s AI bots are actually doing. Use their proven jobs with your own bot—or submit one that
        worked for you.
      </p>
    </div>
  </div>
</section>
